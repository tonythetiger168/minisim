// A DMA controller with four channels, as a portable stimulus model.
//
//   mpss dma.pss -n 4 -print -c dma_tests.c -sv dma_tests_pkg.sv
//
// Memory regions are buffers: an action that reads one needs an action that
// wrote it earlier. The entry activity only asks for copies and checks; mpss
// adds the init_mem actions that give the copies something to read.
//
// Each buffer claims its memory from the address space sys_mem
// (addr_reg_pkg), so no two buffers of a test overlap, and a check can
// compare the data with what the first write put there.
package mem_pkg {
  enum kind_e { RAM, ROM, MMIO }

  buffer data_buff_s {
    rand addr_reg_pkg::transparent_addr_claim_s<> mem;
    rand kind_e kind;
    rand bit[8] seed;   // the data: byte i is seed + i
    constraint mem.size in [4..256];
    constraint mem.size % 4 == 0;
    constraint mem.alignment == 4;
  }

  resource channel_s { }
}

// What the test platform provides: in C these are extern functions, in UVM
// they are tasks of the generated API class.
import target function void dma_copy(bit[8] chan, bit[32] src, bit[32] dst, bit[16] size);
import target function void mem_fill(bit[32] addr, bit[16] size, bit[8] seed);
import target function bit[32] mem_check(bit[32] addr, bit[16] size, bit[8] seed);

// A function of the model itself: generated into both outputs.
function bit[16] words(bit[16] size) {
  return size / 4;
}

component dma_c {
  pool [4] mem_pkg::channel_s chan_p;
  bind chan_p *;

  // Copy one region to another over a free channel.
  action mem2mem {
    input mem_pkg::data_buff_s src;
    output mem_pkg::data_buff_s dst;
    lock mem_pkg::channel_s chan;
    constraint src.kind != MMIO;
    constraint dst.kind == RAM;
    constraint dst.mem.size == src.mem.size;
    constraint dst.seed == src.seed;
    exec body {
      dma_copy(chan.instance_id, src.mem.addr, dst.mem.addr, src.mem.size);
    }
  }
}

component pss_top {
  pool mem_pkg::data_buff_s mem_p;
  bind mem_p *;
  dma_c dma0;

  // The memory the buffers are placed in: 0x1000 to 0x7fff.
  addr_reg_pkg::transparent_addr_space_c<> sys_mem;
  exec init {
    addr_reg_pkg::transparent_addr_region_s<> ram;
    ram.addr = 0x1000;
    ram.size = 0x7000;
    (void)sys_mem.add_region(ram);
  }

  action init_mem {
    output mem_pkg::data_buff_s dst;
    constraint dst.kind == RAM;
    exec body {
      mem_fill(dst.mem.addr, dst.mem.size, dst.seed);
    }
  }

  action check_mem {
    input mem_pkg::data_buff_s src;
    exec body {
      bit[32] bad = mem_check(src.mem.addr, src.mem.size, src.seed);
      if (bad == 0) {
        print("check %x: %d words\n", src.mem.addr, words(src.mem.size));
      } else {
        print("check %x: %d bytes are wrong\n", src.mem.addr, bad);
      }
    }
  }

  action entry {
    rand bit[4] in [1..3] rounds;
    dma_c::mem2mem a, b;
    activity {
      repeat (rounds) {
        // Two copies at once: they get different channels.
        parallel {
          a;
          b with { src.mem.size >= 64; };
        }
        select {
          do check_mem;
          [3]: do dma_c::mem2mem;
        }
      }
      do check_mem;
    }
  }
}
