# FST output: the same run written as VCD and as FST must hold the same value
# changes under the same hierarchy (compared with test_fst), for the
# interpreter and for -compile, and -fst / +fst pick the default file name.
#   cmake -DMSIM=<msim> -DCHK=<test_fst> -DSRC=<source dir> -DOUT=<dir> -P msim_fst.cmake
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})
function(run name)
  execute_process(COMMAND ${MSIM} ${ARGN} WORKING_DIRECTORY ${OUT}
                  RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name}: msim exited ${rc}\n${err}")
  endif()
endfunction()
function(norm file var)
  execute_process(COMMAND ${CHK} ${file} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "test_fst ${file} failed: ${err}")
  endif()
  set(${var} "${o}" PARENT_SCOPE)
endfunction()

set(ADDER ${SRC}/examples/cli/adder.sv ${SRC}/examples/cli/adder_tb.sv -top adder_tb)
set(LANES ${SRC}/bench/lanes.sv +define+END_TIME=400)
foreach(design ADDER LANES)
  run(${design}-vcd ${${design}} -vcd ${design}.vcd)
  run(${design}-fst ${${design}} -vcd ${design}.fst)
  run(${design}-cfst ${${design}} -compile -o ${design}.d -fst ${design}_c.fst)
  norm(${OUT}/${design}.vcd v)
  norm(${OUT}/${design}.fst f)
  norm(${OUT}/${design}_c.fst c)
  if(v STREQUAL "")
    message(FATAL_ERROR "${design}: empty waveform")
  endif()
  if(NOT v STREQUAL f)
    message(FATAL_ERROR "${design}: FST differs from VCD\n--- vcd\n${v}--- fst\n${f}")
  endif()
  if(NOT v STREQUAL c)
    message(FATAL_ERROR "${design}: -compile FST differs from VCD\n--- vcd\n${v}--- fst\n${c}")
  endif()
endforeach()
string(FIND "${v}" " " sp)
if(NOT v MATCHES "\n0 lanes\\.")
  message(FATAL_ERROR "lanes: expected the top scope 'lanes' in the waveform\n${v}")
endif()

run(plus ${ADDER} +fst)
if(NOT EXISTS ${OUT}/dump.fst)
  message(FATAL_ERROR "+fst did not write dump.fst")
endif()
