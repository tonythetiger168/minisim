*SPEF "IEEE 1481-1999"
*DESIGN "dut"
*DATE "today"
*VENDOR "minisim"
*PROGRAM "hand"
*VERSION "1"
*DESIGN_FLOW "EXTERNAL_LOADS"
*DIVIDER /
*DELIMITER :
*BUS_DELIMITER [ ]
*T_UNIT 1 NS
*C_UNIT 1 PF
*R_UNIT 1 OHM
*L_UNIT 1 HENRY

*NAME_MAP
*1 n1
*2 n2

*PORTS
clk I
a I
b I
y O

*D_NET clk 0.001
*CONN
*P clk I
*I r:CK I
*CAP
1 clk 0.001
*END

*D_NET a 0.001
*CONN
*P a I
*I u1:A I
*CAP
1 a 0.001
*END

*D_NET b 0.001
*CONN
*P b I
*I u2:B I
*CAP
1 b 0.0004
2 u2:B 0.0006
*END

*D_NET *1 0.001
*CONN
*I u1:Y O
*I u2:A I
*CAP
1 *1 0.001
*END

*D_NET *2 0.001
*CONN
*I u2:Y O
*I r:D I
*CAP
1 *2 0.0005
2 *2 *1 0.0005
*END
