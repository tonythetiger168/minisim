/* A small library for the mpower tests. Energies are in pJ (1 pF * 1 V^2),
   leakage in nW, and most tables are scalars so the expected power can be
   worked out by hand (tests/mpower.cmake has the arithmetic). */
library (pw) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1, pf);
  nom_voltage : 1.0;
  power_lut_template (pwr_2x2) {
    variable_1 : input_transition_time;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.0, 1.0");
    index_2 ("0.0, 0.1");
  }
  cell (INV) {
    area : 1;
    leakage_power () { when : "A"; value : 4; }
    leakage_power () { when : "!A"; value : 2; }
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) { direction : output; function : "!A";
      internal_power () { related_pin : "A";
        rise_power (scalar) { values ("0.006"); }
        fall_power (scalar) { values ("0.004"); } } }
  }
  cell (BUF) {
    area : 1.5; cell_leakage_power : 3;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) { direction : output; function : "A";
      internal_power () { related_pin : "A";
        rise_power (scalar) { values ("0.008"); }
        fall_power (scalar) { values ("0.006"); } } }
  }
  cell (NAND2) {
    area : 2; cell_leakage_power : 3;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) { direction : output; function : "!(A & B)";
      internal_power () { related_pin : "A";
        rise_power (scalar) { values ("0.010"); }
        fall_power (scalar) { values ("0.008"); } }
      internal_power () { related_pin : "B";
        rise_power (scalar) { values ("0.014"); }
        fall_power (scalar) { values ("0.012"); } } }
  }
  cell (XOR2) {
    area : 3; cell_leakage_power : 5;
    pin (A) { direction : input; capacitance : 0.003; }
    pin (B) { direction : input; capacitance : 0.003; }
    pin (Y) { direction : output; function : "A ^ B";
      /* energy = 0.010 + 0.02 * transition + 0.5 * load */
      internal_power () { related_pin : "A B";
        rise_power (pwr_2x2) { values ("0.010, 0.060", "0.030, 0.080"); }
        fall_power (pwr_2x2) { values ("0.010, 0.060", "0.030, 0.080"); } } }
  }
  cell (DFF) {
    area : 5; cell_leakage_power : 10;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "D"; }
    pin (D) { direction : input; capacitance : 0.002; }
    pin (CK) { direction : input; clock : true; capacitance : 0.003;
      internal_power () {
        rise_power (scalar) { values ("0.020"); }
        fall_power (scalar) { values ("0.018"); } } }
    pin (Q) { direction : output; function : "IQ";
      internal_power () { related_pin : "CK";
        rise_power (scalar) { values ("0.030"); }
        fall_power (scalar) { values ("0.026"); } } }
  }
  cell (CKGATE) {
    area : 4; cell_leakage_power : 6;
    clock_gating_integrated_cell : "latch_posedge";
    latch (IQ, IQN) { enable : "!CK"; data_in : "EN"; }
    pin (EN) { direction : input; capacitance : 0.002; }
    pin (CK) { direction : input; clock : true; capacitance : 0.003;
      internal_power () {
        rise_power (scalar) { values ("0.005"); }
        fall_power (scalar) { values ("0.005"); } } }
    pin (GCK) { direction : output; function : "CK & IQ";
      internal_power () { related_pin : "CK";
        rise_power (scalar) { values ("0.010"); }
        fall_power (scalar) { values ("0.010"); } } }
  }
}
