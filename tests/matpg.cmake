# matpg self-test: coverage numbers on known designs, the same patterns for
# any thread count, a round trip through -faultsim, and (with a simulator)
# the generated testbench passing on the good netlist and failing on a
# netlist with a detected fault wired in.
#   cmake -DMATPG=<matpg> -DSRC=<source dir> -DOUT=<scratch dir>
#         [-DMSIM=<msim>] [-DIVERILOG=<iverilog> -DVVP=<vvp>] -P matpg.cmake
set(T ${SRC}/tests/atpg)
file(MAKE_DIRECTORY ${OUT})

function(run)
  execute_process(COMMAND ${MATPG} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(out "${out}${err}" PARENT_SCOPE)
  set(rc ${rc} PARENT_SCOPE)
endfunction()
function(expect what)
  foreach(want ${ARGN})
    string(FIND "${out}" "${want}" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "${what}: missing '${want}' in:\n${out}")
    endif()
  endforeach()
endfunction()
function(ok what)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${what}: exit ${rc}\n${out}")
  endif()
endfunction()

# c17 as gate primitives: every fault is testable.
run(${T}/c17.v -min_coverage 100)
ok(c17)
expect(c17 "6 gates, 0 flops" "total faults                                   50"
       "test coverage                             100.00%" "fault coverage                            100.00%")

# Redundant logic is undetectable, not lost coverage.
run(${T}/redundant.v -faults ${OUT}/redundant.flt -min_coverage 100)
ok(redundant)
expect(redundant "redundant                       UR            5" "test coverage                             100.00%")
file(READ ${OUT}/redundant.flt flt)
if(NOT flt MATCHES "sa0  UR  u_and/B" OR NOT flt MATCHES "sa1  DS  u_or/A")
  message(FATAL_ERROR "redundant.flt:\n${flt}")
endif()

# A flop on a gated clock is reported and read as unknown; the rest is tested.
run(${T}/nonscan.v -drc -fault all)
ok(nonscan)
expect(nonscan "4 flops, 3 on 1 scan chain" "chain 1: scan_in -> scan_out, 3 cells, clock clk"
       "flop 'u_gated' is not scanned: the tester cannot reach its clock"
       "stuck-at fault summary" "transition fault summary")
if(out MATCHES "did not simulate as detecting")
  message(FATAL_ERROR "generator and simulator disagree:\n${out}")
endif()

# The coverage gate.
run(${T}/nonscan.v -min_coverage 99)
if(NOT rc EQUAL 1 OR NOT out MATCHES "is under 99")
  message(FATAL_ERROR "-min_coverage did not fail the run (exit ${rc}):\n${out}")
endif()

# Both scan styles and a Liberty library; every output format; any thread count.
foreach(d scan muxscan libscan)
  set(lib "")
  set(cells ${T}/generic_cells.v)
  if(d STREQUAL libscan)
    set(lib -lib ${T}/tiny.lib)
    set(cells ${T}/tiny_cells.v)
  endif()
  run(${T}/${d}.v ${lib} -fault all -threads 1 -patterns ${OUT}/${d}_1.pat -tb ${OUT}/${d}_tb.v
      -stil ${OUT}/${d}.stil -faults ${OUT}/${d}.flt -json ${OUT}/${d}.json)
  ok(${d})
  set(first "${out}")
  if(out MATCHES "did not simulate as detecting" OR out MATCHES "not scanned")
    message(FATAL_ERROR "${d}:\n${out}")
  endif()
  run(${T}/${d}.v ${lib} -fault all -threads 4 -patterns ${OUT}/${d}_4.pat -cubes ${OUT}/${d}.cubes)
  ok(${d})
  # Each cube is its pattern with some bits left free: reading x as "any
  # bit", the cube lines of a pattern put end to end match the pattern line.
  file(STRINGS ${OUT}/${d}_4.pat plines REGEX "^p ")
  file(STRINGS ${OUT}/${d}.cubes clines REGEX "^[0-9]")
  file(STRINGS ${OUT}/${d}.cubes chead REGEX "^chains ")
  if(d STREQUAL scan AND NOT chead STREQUAL "chains scan_in[1] scan_in[0]")
    message(FATAL_ERROR "${d}: the cube file's chain line is '${chead}'")
  endif()
  set(id 0)
  set(free 0)
  foreach(pl ${plines})
    string(REGEX REPLACE "^p [a-z]+ ([01]+) ([01]+)$" "\\1\\2" bits "${pl}")
    set(cube "")
    foreach(cl ${clines})
      if(cl MATCHES "^${id} [a-z0-9]+ ([01x]+)$")
        string(APPEND cube "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    if(cube MATCHES "x")
      set(free 1)
    endif()
    string(REPLACE "x" "." re "${cube}")
    if(NOT bits MATCHES "^${re}$")
      message(FATAL_ERROR "${d}: cube ${id} (${cube}) is not pattern ${id} (${bits})")
    endif()
    math(EXPR id "${id} + 1")
  endforeach()
  # (libscan is small enough that random patterns alone finish it.)
  if(NOT free AND NOT d STREQUAL libscan)
    message(FATAL_ERROR "${d}: no cube leaves a bit free")
  endif()
  file(READ ${OUT}/${d}_1.pat p1)
  file(READ ${OUT}/${d}_4.pat p4)
  if(NOT p1 STREQUAL p4)
    message(FATAL_ERROR "${d}: the patterns differ between -threads 1 and -threads 4")
  endif()
  # Grading the patterns it wrote finds the same faults.
  run(${T}/${d}.v ${lib} -fault all -faultsim ${OUT}/${d}_1.pat)
  ok("${d} -faultsim")
  foreach(kind "by simulation")
    string(REGEX MATCHALL "${kind} +DS +[0-9]+" a "${first}")
    string(REGEX MATCHALL "${kind} +DS +[0-9]+" b "${out}")
    if(NOT a STREQUAL b)
      message(FATAL_ERROR "${d}: -faultsim detects '${b}', generation said '${a}'")
    endif()
  endforeach()
  file(READ ${OUT}/${d}.stil stil)
  foreach(want "STIL 1.0" "ScanStructures" "ScanChain \"chain1\"" "Call \"load_unload\"" "Call \"capture\"")
    string(FIND "${stil}" "${want}" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "${d}.stil has no ${want}")
    endif()
  endforeach()
  file(READ ${OUT}/${d}.json json)
  if(NOT json MATCHES "\"fault\": \"stuck-at\"" OR NOT json MATCHES "\"fault\": \"transition\"")
    message(FATAL_ERROR "${d}.json:\n${json}")
  endif()

  # Replay in a simulator: the patterns pass on the design ...
  set(sims "")
  if(MSIM)
    list(APPEND sims msim)
  endif()
  if(IVERILOG AND VVP)
    list(APPEND sims iverilog)
  endif()
  # ... and fail on a copy with a detected fault wired in (scan.v: the output
  # of gate U<k> is net n<k>).
  set(bad "")
  if(d STREQUAL scan)
    file(READ ${OUT}/${d}.flt flt)
    string(REGEX MATCH "sa([01])  DS  U([0-9]+)/Y" hit "${flt}")
    if(NOT hit)
      message(FATAL_ERROR "no detected gate-output fault in ${d}.flt")
    endif()
    set(v ${CMAKE_MATCH_1})
    set(g ${CMAKE_MATCH_2})
    file(READ ${T}/${d}.v net)
    string(REPLACE ".Y(n${g}));" ".Y(n${g}_cut));\n  assign n${g} = 1'b${v};" net "${net}")
    string(REPLACE "  wire q0;" "  wire n${g}_cut;\n  wire q0;" net "${net}")
    file(WRITE ${OUT}/${d}_bad.v "${net}")
    set(bad ${OUT}/${d}_bad.v)
  endif()
  foreach(sim ${sims})
    foreach(net ${T}/${d}.v ${bad})
      if(sim STREQUAL msim)
        execute_process(COMMAND ${MSIM} ${OUT}/${d}_tb.v ${net} ${cells} +faillog
                        WORKING_DIRECTORY ${OUT}
                        RESULT_VARIABLE src OUTPUT_VARIABLE sout ERROR_VARIABLE serr)
      else()
        execute_process(COMMAND ${IVERILOG} -o ${OUT}/${d}.vvp ${OUT}/${d}_tb.v ${net} ${cells}
                        RESULT_VARIABLE src OUTPUT_VARIABLE sout ERROR_VARIABLE serr)
        if(src EQUAL 0)
          execute_process(COMMAND ${VVP} -n ${OUT}/${d}.vvp +faillog
                          WORKING_DIRECTORY ${OUT}
                          RESULT_VARIABLE src OUTPUT_VARIABLE sout ERROR_VARIABLE serr)
        endif()
      endif()
      if(net STREQUAL "${bad}")
        if(NOT sout MATCHES "ATPG FAIL")
          message(FATAL_ERROR "${d} on ${sim}: fault sa${v} on n${g} was not caught:\n${sout}${serr}")
        endif()
      elseif(NOT sout MATCHES "ATPG PASS")
        message(FATAL_ERROR "${d} on ${sim}: the patterns do not pass:\n${sout}${serr}")
      endif()
      # The fail log (+faillog): nothing on the good design; on the faulty
      # one a line per wrong bit, "<pattern> <chain> <cell>" or
      # "<pattern> po <port>", the same from every simulator.
      file(STRINGS ${OUT}/${d}.faillog fl)
      list(POP_FRONT fl head)
      if(NOT head STREQUAL "top ${d}")
        message(FATAL_ERROR "${d} on ${sim}: the fail log starts with '${head}'")
      endif()
      if(net STREQUAL "${bad}")
        if(NOT fl)
          message(FATAL_ERROR "${d} on ${sim}: the fail log names no failing bit")
        endif()
        foreach(l ${fl})
          if(NOT l MATCHES "^[0-9]+ ([01] [0-3]|po [a-z_0-9]+\\[[0-9]+\\])$")
            message(FATAL_ERROR "${d} on ${sim}: fail log line '${l}'")
          endif()
        endforeach()
        if(DEFINED faillog_${d} AND NOT "${fl}" STREQUAL "${faillog_${d}}")
          message(FATAL_ERROR "${d}: the fail log differs between simulators")
        endif()
        set(faillog_${d} "${fl}")
      elseif(fl)
        message(FATAL_ERROR "${d} on ${sim}: a fail log on the good design: ${fl}")
      endif()
      file(REMOVE ${OUT}/${d}.faillog)
    endforeach()
  endforeach()
endforeach()

# Errors a user will meet.
run(${T}/libscan.v)
if(rc EQUAL 0 OR NOT out MATCHES "in no library")
  message(FATAL_ERROR "an unknown cell was accepted:\n${out}")
endif()
run(${T}/scan.v -fault bogus)
if(rc EQUAL 0)
  message(FATAL_ERROR "-fault bogus was accepted")
endif()
