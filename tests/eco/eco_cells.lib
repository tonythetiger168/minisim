/* Cells the ECO tests need beside tests/sta/sta_test.lib: a scan flop, a
   flop with both outputs, an enable flop and an and-or-invert gate. Function
   only; no timing. */
library (eco_cells) {
  cell (SDFF_X1) {
    area : 9;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "(SE * SI) + (!SE * D)"; }
    pin (CK) { direction : input; clock : true; }
    pin (D) { direction : input; }
    pin (SI) { direction : input; }
    pin (SE) { direction : input; }
    pin (Q) { direction : output; function : "IQ"; }
  }
  cell (SDFFR_X1) {
    area : 10;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "(SE * SI) + (!SE * D)"; clear : "!RN"; }
    pin (CK) { direction : input; clock : true; }
    pin (D) { direction : input; }
    pin (SI) { direction : input; }
    pin (SE) { direction : input; }
    pin (RN) { direction : input; }
    pin (Q) { direction : output; function : "IQ"; }
  }
  cell (DFFQN_X1) {
    area : 7;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "D"; }
    pin (CK) { direction : input; clock : true; }
    pin (D) { direction : input; }
    pin (Q) { direction : output; function : "IQ"; }
    pin (QN) { direction : output; function : "IQN"; }
  }
  cell (DFFE_X1) {
    area : 8;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "(E * D) + (!E * IQ)"; }
    pin (CK) { direction : input; clock : true; }
    pin (D) { direction : input; }
    pin (E) { direction : input; }
    pin (Q) { direction : output; function : "IQ"; }
  }
  cell (AOI21_X1) {
    area : 2;
    pin (A1) { direction : input; }
    pin (A2) { direction : input; }
    pin (B) { direction : input; }
    pin (Y) { direction : output; function : "!((A1 * A2) + B)"; }
  }
  cell (RAM4) {
    area : 100;
    pin (CK) { direction : input; clock : true; }
    pin (WE) { direction : input; }
    pin (A) { direction : input; }
    pin (DI) { direction : input; }
    pin (DO) { direction : output; }
  }
}
