# A floorplan for counter.v: a wide die, one fixed flop, one port placed by
# hand, and a placement blockage in the middle of the core.
VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN counter ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 60800 33600 ) ;
COMPONENTS 1 ;
- r0 DFFR + FIXED ( 22800 11200 ) N ;
END COMPONENTS
PINS 1 ;
- clk + NET clk + DIRECTION INPUT + USE SIGNAL
  + LAYER m3 ( 0 -70 ) ( 1520 70 ) + PLACED ( 0 16940 ) N ;
END PINS
BLOCKAGES 1 ;
- PLACEMENT RECT ( 30400 11200 ) ( 34200 22400 ) ;
END BLOCKAGES
END DESIGN
