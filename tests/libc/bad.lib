/* One mistake per cell, for the mlibc check. */
library (bad) {
  delay_model : table_lookup;
  time_unit : "1ns";
  capacitive_load_unit (1, pf);
  leakage_power_unit : "1nW";
  lu_table_template (d2) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.1");
    index_2 ("0.001, 0.01");
  }
  lu_table_template (c2) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.01, 0.1");
    index_2 ("0.01, 0.1");
  }
  /* a clean cell: nothing is reported for it */
  cell (GOOD_X1) {
    area : 1;
    cell_leakage_power : 1;
    leakage_power () { when : "A"; value : 1.2; }
    leakage_power () { when : "!A"; value : 0.8; }
    pin (A) { direction : input; capacitance : 0.001; }
    pin (Y) {
      direction : output; function : "!A"; max_capacitance : 0.01;
      timing () {
        related_pin : "A"; timing_sense : negative_unate;
        cell_rise (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
        cell_fall (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
        rise_transition (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
        fall_transition (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
      }
    }
  }
  /* LIB013: stronger and slower, and smaller */
  cell (GOOD_X2) {
    area : 0.9;
    cell_leakage_power : 2;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output; function : "!A"; max_capacitance : 0.02;
      timing () {
        related_pin : "A"; timing_sense : negative_unate;
        cell_rise (d2) { values ("0.02, 0.07", "0.03, 0.08"); }
        cell_fall (d2) { values ("0.02, 0.07", "0.03, 0.08"); }
        rise_transition (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
        fall_transition (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
      }
    }
  }
  /* LIB001 no function, LIB007 no capacitance, LIB009 no area, LIB010, LIB012 no leakage */
  cell (NOFUNC) {
    pin (A) { direction : input; }
    pin (Y) { direction : output; }
  }
  /* LIB002: an AND declared negative_unate. LIB003: B has no arc. LIB004: an arc from C */
  cell (SENSE) {
    area : 1;
    cell_leakage_power : 1;
    pin (A) { direction : input; capacitance : 0.001; }
    pin (B) { direction : input; capacitance : 0.001; }
    pin (C) { direction : input; capacitance : 0.001; }
    pin (Y) {
      direction : output; function : "A*B"; max_capacitance : 0.01;
      timing () {
        related_pin : "A"; timing_sense : negative_unate;
        cell_rise (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
        cell_fall (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
      }
      timing () {
        related_pin : "C"; timing_sense : positive_unate;
        cell_rise (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
        cell_fall (d2) { values ("0.02, 0.05", "0.03, 0.06"); }
      }
    }
  }
  /* LIB005: faster at a larger load. LIB006: a negative delay. LIB014: index goes down */
  cell (TABLES) {
    area : 1;
    cell_leakage_power : 1;
    pin (A) { direction : input; capacitance : 0.001; }
    pin (Y) {
      direction : output; function : "A"; max_capacitance : 0.01;
      timing () {
        related_pin : "A"; timing_sense : positive_unate;
        cell_rise (d2) { values ("0.05, 0.02", "0.06, 0.07"); }
        cell_fall (d2) { values ("-0.01, 0.05", "0.03, 0.06"); }
        rise_transition (d2) { index_1 ("0.1, 0.01"); values ("0.02, 0.05", "0.03, 0.06"); }
      }
    }
  }
  /* LIB008: no hold on D, and CK is not marked as a clock. LIB011: a typo in the function */
  cell (FLOP) {
    area : 4;
    cell_leakage_power : 5;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "D"; }
    pin (D) {
      direction : input; capacitance : 0.001;
      timing () {
        related_pin : "CK"; timing_type : setup_rising;
        rise_constraint (c2) { values ("0.03, 0.04", "0.03, 0.04"); }
        fall_constraint (c2) { values ("0.03, 0.04", "0.03, 0.04"); }
      }
    }
    pin (CK) { direction : input; capacitance : 0.001; }
    pin (Q) {
      direction : output; function : "IQQ"; max_capacitance : 0.01;
      timing () {
        related_pin : "CK"; timing_type : rising_edge;
        cell_rise (d2) { values ("0.05, 0.08", "0.06, 0.09"); }
        cell_fall (d2) { values ("0.05, 0.08", "0.06, 0.09"); }
      }
    }
  }
  /* LIB012: A*B and A overlap. LIB015: no arc at all. LIB010: no max_capacitance */
  cell (LEAK) {
    area : 1;
    cell_leakage_power : 1;
    leakage_power () { when : "A*B"; value : 1.2; }
    leakage_power () { when : "A"; value : 0.8; }
    pin (A) { direction : input; capacitance : 0.001; }
    pin (B) { direction : input; capacitance : 0.001; }
    pin (Y) { direction : output; function : "A+B"; }
  }
}
