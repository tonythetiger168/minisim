(SAIFILE
(SAIFVERSION "2.0")
(DIRECTION "backward")
(DESIGN "top")
(VENDOR "minisim")
(PROGRAM_NAME "msim")
(DIVIDER / )
(TIMESCALE 1 ns)
(DURATION 100)
(INSTANCE top
 (NET
  (a (T0 20) (T1 80) (TX 0) (TC 3) (IG 0))
  (b (T0 70) (T1 30) (TX 0) (TC 2) (IG 0))
  (clk (T0 50) (T1 50) (TX 0) (TC 20) (IG 0))
  (q\[0\] (T0 70) (T1 25) (TX 5) (TC 5) (IG 0))
  (q\[1\] (T0 75) (T1 20) (TX 5) (TC 2) (IG 0))
  (rst (T0 50) (T1 50) (TX 0) (TC 1) (IG 0))
  (y (T0 79) (T1 20) (TX 1) (TC 4) (IG 0))
 )
 (INSTANCE "AN2" u_and
  (PORT
   (A (T0 20) (T1 80) (TX 0) (TC 3) (IG 0)
    (COND B (RISE) (TC 1)
     COND B (FALL) (TC 1)
     COND_DEFAULT (TC 1)))
   (B (T0 70) (T1 30) (TX 0) (TC 2) (IG 0)
    (COND A (RISE) (TC 1)
     COND A (FALL) (TC 1)
     COND_DEFAULT (TC 0)))
   (Y (T0 79) (T1 20) (TX 1) (TC 4) (IG 0)
    (COND A (RISE) (IOPATH B (TC 1))
     COND A (FALL) (IOPATH B (TC 1))
     COND B (RISE) (IOPATH A (TC 1))
     COND B (FALL) (IOPATH A (TC 0))
     COND_DEFAULT (TC 0)))
  )
  (LEAKAGE
   (COND (A * B) (T1 20) (T0 80)
    COND (A | B) (T1 70) (T0 30)
    COND_DEFAULT (T1 10) (T0 90))
  )
 )
 (INSTANCE u_cnt
  (NET
   (clk (T0 50) (T1 50) (TX 0) (TC 20) (IG 0))
   (q\[0\] (T0 70) (T1 25) (TX 5) (TC 5) (IG 0))
   (q\[1\] (T0 75) (T1 20) (TX 5) (TC 2) (IG 0))
   (rst (T0 50) (T1 50) (TX 0) (TC 1) (IG 0))
  )
 )
)
)
