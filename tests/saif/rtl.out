(SAIFILE
(SAIFVERSION "2.0")
(DIRECTION "backward")
(DESIGN "top")
(VENDOR "minisim")
(PROGRAM_NAME "msim")
(DIVIDER / )
(TIMESCALE 1 ns)
(DURATION 100)
(INSTANCE "top" top
 (NET
  (y_net (T0 79) (T1 20) (TX 1) (TC 4) (IG 0))
 )
 (INSTANCE "counter" u_cnt
  (PORT
   (clk (T0 50) (T1 50) (TX 0) (TC 20) (IG 0))
  )
  (VIRTUAL_INSTANCE "sequential" q_reg\[1\]
   (PORT
    (Q (T0 75) (T1 20) (TX 5) (TC 2) (IG 0))
   )
  )
  (VIRTUAL_INSTANCE "sequential" q_reg\[0\]
   (PORT
    (Q (T0 70) (T1 25) (TX 5) (TC 5) (IG 0))
   )
  )
 )
)
)
