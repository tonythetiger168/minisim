# mregress self-test: run tests/regress/smoke.list on msim. Five runs pass and
# one (wrong_expect) must fail and one is a known gap (xfail), then -rerun repeats only that one.
#   cmake -DPY=<python3> -DMSIM=<msim> -DSRC=<source dir> -DOUT=<dir> -P mregress.cmake
set(MR ${PY} ${SRC}/tools/mregress.py)
file(REMOVE_RECURSE ${OUT})
execute_process(COMMAND ${MR} ${SRC}/tests/regress/smoke.list -exe ${MSIM} -o ${OUT} -seed 7 -j 2
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 1)
  message(FATAL_ERROR "mregress exited ${rc}, expected 1\n${out}${err}")
endif()
if(NOT out MATCHES "5 passed, 1 failed, 0 skipped, 1 known gaps")
  message(FATAL_ERROR "unexpected summary:\n${out}")
endif()
if(NOT out MATCHES "FAIL  wrong_expect  seed=7")
  message(FATAL_ERROR "wrong_expect did not fail:\n${out}")
endif()
foreach(f results.json junit.xml report.html runs/adder_seeds_s9/sim.log runs/adder_seeds_s9/cmd.sh)
  if(NOT EXISTS ${OUT}/${f})
    message(FATAL_ERROR "missing ${OUT}/${f}")
  endif()
endforeach()
file(READ ${OUT}/junit.xml junit)
if(NOT junit MATCHES "failures=\"1\"")
  message(FATAL_ERROR "junit.xml does not record one failure:\n${junit}")
endif()
execute_process(COMMAND ${MR} ${SRC}/tests/regress/smoke.list -exe ${MSIM} -o ${OUT} -rerun
                RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT out MATCHES "FAIL  wrong_expect" OR out MATCHES "adder_seeds")
  message(FATAL_ERROR "-rerun should repeat only wrong_expect:\n${out}")
endif()
if(NOT out MATCHES "5 passed, 1 failed")
  message(FATAL_ERROR "-rerun lost the earlier passes:\n${out}")
endif()

# Spec mode: //! xfail: (known gap), an xfail that passes (xpass, an error),
# //! exit: <status>, and the per-chapter table.
execute_process(COMMAND ${MR} -spec ${SRC}/tests/regress/spec -exe ${MSIM} -o ${OUT}/spec -q -md ${OUT}/spec/chapters.md
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR NOT out MATCHES "2 passed, 1 failed, 0 skipped, 1 known gaps")
  message(FATAL_ERROR "spec mode: rc=${rc}\n${out}${err}")
endif()
if(NOT out MATCHES "\\| 2 \\| 1 \\| 1 \\| 0 \\| 2-xpass \\(xfail passes\\) \\| 50% \\|")
  message(FATAL_ERROR "spec mode chapter table:\n${out}")
endif()
if(NOT EXISTS ${OUT}/spec/chapters.md)
  message(FATAL_ERROR "missing chapters.md")
endif()

# mbug reads results.json: the failure becomes one issue (dry run, no server).
execute_process(COMMAND ${PY} ${SRC}/tools/mbug.py regress ${OUT}/results.json -project you/repo -dry-run
                        -o ${OUT}/bugs.json
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "create .*\\[mregress\\] no line matches @pass=this text is never printed")
  message(FATAL_ERROR "mbug dry run: rc=${rc}\n${out}${err}")
endif()
file(READ ${OUT}/bugs.json bugs)
if(NOT bugs MATCHES "-filter '\\^wrong_expect\\$' -seed 7 -seeds 1")
  message(FATAL_ERROR "mbug repro command:\n${bugs}")
endif()

# Farm dispatch through a stand-in launcher: runs go through job.sh, a lost job is submitted again,
# a job that never runs fails with a farm: reason, and the verdicts match the local run.
execute_process(COMMAND ${MR} ${SRC}/tests/regress/smoke.list -exe ${MSIM} -o ${OUT}/farm -seed 7 -farm-cpus 2 -farm-retries 1
                        -farm "cmd:${PY} ${SRC}/tests/regress/fakefarm.py ${OUT}/farmlog {name} {cpus} {job}"
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR NOT out MATCHES "4 passed, 2 failed, 0 skipped, 1 known gaps")
  message(FATAL_ERROR "farm run: rc=${rc}\n${out}${err}")
endif()
if(NOT out MATCHES "FAIL  wrong_expect  seed=7" OR NOT out MATCHES "FAIL  unique_case  seed=7 [^\n]*farm: the job did not run \\(submit exit 1, fakefarm: host unreachable\\), 2 attempts")
  message(FATAL_ERROR "farm run: wrong failures\n${out}")
endif()
file(READ ${OUT}/farmlog/submitted sub)
string(REGEX MATCHALL "adder_w8_s7 cpus=2" twice "${sub}")
list(LENGTH twice n)
if(NOT n EQUAL 2)
  message(FATAL_ERROR "the lost job was submitted ${n} time(s), expected 2\n${sub}")
endif()
file(READ ${OUT}/farm/runs/adder_w8_s7/cmd.sh cmd)
if(NOT cmd MATCHES "-threads 2" OR NOT EXISTS ${OUT}/farm/runs/adder_w8_s7/job.rc)
  message(FATAL_ERROR "farm run: -farm-cpus did not reach msim, or no job.rc\n${cmd}")
endif()
# The submit commands of the real schedulers (-farm-dry runs nothing).
foreach(kind lsf slurm sge ssh)
  set(spec ${kind})
  if(kind STREQUAL "ssh")
    set(spec "ssh:hostA,hostB*2")
  endif()
  execute_process(COMMAND ${MR} ${SRC}/tests/regress/smoke.list -exe ${MSIM} -o ${OUT}/dry -seed 7 -filter adder_w8
                          -farm ${spec} -farm-cpus 4 "-farm-opts=-q regress" -farm-dry
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "-farm ${kind} -farm-dry: rc=${rc}\n${out}${err}")
  endif()
  set(dry_${kind} "${out}")
endforeach()
if(NOT dry_lsf MATCHES "^bsub -K -J mregress_[0-9]+_adder_w8_s7 -n 4 -R \"span\\[hosts=1\\]\" -o /dev/null -e /dev/null -q regress sh [^\n]*/runs/adder_w8_s7/job\\.sh\n$")
  message(FATAL_ERROR "lsf submit command:\n${dry_lsf}")
endif()
if(NOT dry_slurm MATCHES "^srun --quiet -J mregress_[0-9]+_adder_w8_s7 -n 1 -c 4 -q regress sh ")
  message(FATAL_ERROR "slurm submit command:\n${dry_slurm}")
endif()
if(NOT dry_sge MATCHES "^qsub -sync y -b y -N mregress_[0-9]+_adder_w8_s7 -pe smp 4 -o /dev/null -e /dev/null -q regress sh ")
  message(FATAL_ERROR "sge submit command:\n${dry_sge}")
endif()
if(NOT dry_ssh MATCHES "^ssh -o BatchMode=yes -q regress HOST sh ")
  message(FATAL_ERROR "ssh submit command:\n${dry_ssh}")
endif()
execute_process(COMMAND ${MR} ${SRC}/tests/regress/smoke.list -exe ${MSIM} -o ${OUT}/dry -farm pbs RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 2 OR NOT err MATCHES "-farm is lsf, slurm, sge")
  message(FATAL_ERROR "-farm pbs: rc=${rc}\n${out}${err}")
endif()
