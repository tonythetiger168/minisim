# mcov with other vendors' coverage command lines (docs/COMPAT.md): URG
# (--compat=synopsys), IMC batch (--compat=cadence) and vcover
# (--compat=siemens), or the name mcov is started as. The same engine runs:
# each form must give what the native command gives.
#   cmake -DPY=<python3> -DMSIM=<msim> -DSRC=<source dir> -DOUT=<dir> -P mcov_compat.cmake
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT}/runs)
set(MCOV ${PY} ${SRC}/tools/mcov.py)
foreach(t fsm counter inst)
  execute_process(COMMAND ${MSIM} ${SRC}/tests/cov/${t}.sv -cov runs/${t}.json WORKING_DIRECTORY ${OUT}
                  RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "msim ${t}.sv -cov exited ${rc}: ${err}")
  endif()
endforeach()
file(WRITE ${OUT}/runs/notes.json "{}")   # not a database: a directory scan skips it
function(run want_rc)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY ${OUT} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL want_rc)
    message(FATAL_ERROR "${ARGN} exited ${rc}, expected ${want_rc}:\n${o}${e}")
  endif()
  set(out "${o}" PARENT_SCOPE)
  set(err "${e}" PARENT_SCOPE)
endfunction()
function(same a b what)
  file(READ ${OUT}/${a} x)
  file(READ ${OUT}/${b} y)
  if(NOT x STREQUAL y)
    message(FATAL_ERROR "${what}: ${a} and ${b} differ")
  endif()
endfunction()
set(RUNS runs/counter.json runs/fsm.json runs/inst.json)
string(REPLACE ";" " " RUNS_S "${RUNS}")

# The native results.
run(0 ${MCOV} merge ${RUNS} -o native.json)
run(0 ${MCOV} report native.json -detail -instances)
file(WRITE ${OUT}/native_detail.txt "${out}")
run(0 ${MCOV} report native.json)
file(WRITE ${OUT}/native_summary.txt "${out}")
run(0 ${MCOV} rank ${RUNS})
file(WRITE ${OUT}/native_rank.txt "${out}")

# Siemens: vcover merge / report / ranktest.
run(0 ${MCOV} --compat=siemens merge vc.json ${RUNS})
same(native.json vc.json "vcover merge <out> <in>...")
run(0 ${MCOV} -compat mentor merge -out vc2.json ${RUNS})
same(native.json vc2.json "vcover merge -out")
run(0 ${MCOV} --compat=siemens report -details -output vc_detail.txt vc.json)
same(native_detail.txt vc_detail.txt "vcover report -details")
run(0 ${MCOV} --compat=siemens ranktest -rankfile vc_rank.txt ${RUNS})
same(native_rank.txt vc_rank.txt "vcover ranktest")
run(0 ${MCOV} --compat=siemens report -html -htmldir vc_html vc.json)
if(NOT EXISTS ${OUT}/vc_html/index.html)
  message(FATAL_ERROR "vcover report -html wrote no vc_html/index.html")
endif()
# Started as vcover (a symlink the user makes).
file(CREATE_LINK ${SRC}/tools/mcov.py ${OUT}/vcover SYMBOLIC)
run(0 ${PY} ${OUT}/vcover merge -out link.json ${RUNS})
same(native.json link.json "mcov started as vcover")

# Cadence: IMC batch commands, from -execcmd and from a file.
run(0 ${MCOV} --compat=cadence -64bit -execcmd "merge ${RUNS_S} -out imc.json" -execcmd "load imc.json" -execcmd "report -detail -out imc_detail.txt"
    -execcmd "rank ${RUNS_S} -out keep.txt" -execcmd exit)
same(native.json imc.json "imc merge -out")
same(native_detail.txt imc_detail.txt "imc report -detail")
if(NOT err MATCHES "ignored cadence option -64bit")
  message(FATAL_ERROR "imc -64bit is not reported as ignored:\n${err}")
endif()
file(WRITE ${OUT}/cmds.tcl "# IMC batch file\nload imc.json; report -summary -out imc_summary.txt\n")
run(0 ${MCOV} --compat=cadence -exec cmds.tcl)
same(native_summary.txt imc_summary.txt "imc -exec report -summary")
run(2 ${MCOV} --compat=cadence -execcmd "load imc.json" -execcmd "write_hdl x")
if(NOT err MATCHES "imc command 'write_hdl' is not supported")
  message(FATAL_ERROR "an unknown imc command should be an error:\n${err}")
endif()

# Synopsys: URG.
run(0 ${MCOV} --compat=synopsys -full64 -dir runs -dbname urg.json -report urgReport -format both -grade)
same(native.json urg.json "urg -dir <directory> -dbname")
foreach(f index.html dashboard.txt grades.txt)
  if(NOT EXISTS ${OUT}/urgReport/${f})
    message(FATAL_ERROR "urg -report wrote no urgReport/${f}")
  endif()
endforeach()
same(native_detail.txt urgReport/dashboard.txt "urg dashboard")
run(2 ${MCOV} --compat=synopsys -dir ${OUT}/urgReport/missing)
run(2 ${MCOV} --compat=acme report native.json)
if(NOT err MATCHES "unknown vendor 'acme'")
  message(FATAL_ERROR "an unknown vendor should be an error:\n${err}")
endif()
run(1 ${MCOV} report runs/missing.json)
if(NOT err MATCHES "runs/missing.json: no such database")
  message(FATAL_ERROR "a missing database: ${err}")
endif()
message(STATUS "mcov compat: ok")
