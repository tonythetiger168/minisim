      function : "!A";
      max_capacitance : 0.2;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_3x3) {
          values ("0.05400, 0.07200, 0.25200" , \
                  "0.07200, 0.09000, 0.27000" , \
