// mpss feature test: one of everything in the supported subset.
package cfg_pkg {
  const int BASE = 0x4000;
  const int NPORT = 3;
  typedef bit[12] off_t;
  enum mode_e { IDLE, RD = 4, WR, RDWR }
  enum prio_e { LOW, MID, HIGH }

  struct hdr_s {
    rand bit[4] len;
    rand mode_e mode;
    constraint len_c { len in [1..8]; mode != IDLE; }
  }
  struct ext_hdr_s : hdr_s {
    rand bit[8] tag;
    constraint tag > len;
  }

  stream pkt_s {
    rand ext_hdr_s hdr;
    rand bit[8] data[4];
    constraint foreach (d : data[i]) { d > i * 10; d < 200; }
    constraint unique { data };
    constraint data[0] + data[1] == 100;
  }
  buffer cfg_s {
    rand bit[32] value;
    rand prio_e prio;
  }
  resource port_s { }
  resource lane_s { }
}

import target C function void reg_write(bit[32] addr, bit[32] data);
import target function bit[32] reg_read(bit[32] addr);
function void note(string what, int v) {
  print("%s=%d\n", what, v);
}
// Calls an imported function, so it is a task in the UVM output.
function bit[32] read_twice(bit[32] addr) {
  bit[32] a = reg_read(addr);
  return a + reg_read(addr);
}

component port_c {
  int id;
  bit[32] base = cfg_pkg::BASE;

  action send {
    output cfg_pkg::pkt_s out;
    lock cfg_pkg::port_s port;
    share cfg_pkg::lane_s lane;
    rand bool urgent;
    constraint urgent -> out.hdr.len <= 2;
    constraint if (out.hdr.mode == RD) { out.hdr.tag == 0x55; } else { out.hdr.tag != 0x55; }
    exec body {
      note("send.port", port.instance_id);
      reg_write(comp.base + (comp.id << 8), (out.data[3] << 8) | out.hdr.len);
    }
  }
  action recv {
    input cfg_pkg::pkt_s in_pkt;
    lock cfg_pkg::port_s port;
    share cfg_pkg::lane_s lane;
    exec body {
      bit[32] v;
      int tries = 0;
      v = reg_read(comp.base + in_pkt.hdr.tag);
      while (reg_read(comp.base) != v && tries < 2) {
        tries += 1;
      }
      note("recv.port", port.instance_id);
      note("recv.sum", in_pkt.data[0] + in_pkt.data[1]);
    }
  }
}

component pss_top {
  pool cfg_pkg::pkt_s pkt_p;
  pool cfg_pkg::cfg_s cfg_p;
  pool [cfg_pkg::NPORT] cfg_pkg::port_s port_p;
  pool [2] cfg_pkg::lane_s lane_p;
  bind pkt_p *;
  bind port_p *;
  port_c ports[2];
  string label = "features";

  exec init {
    ports[0].id = 1;
    ports[1].id = 2;
    ports[1].base = cfg_pkg::BASE + 0x1000;
  }

  abstract action base_a {
    rand cfg_pkg::off_t off;
    constraint off % 16 == 0;
  }
  action setup : base_a {
    output cfg_pkg::cfg_s cfg;
    constraint cfg.value == cfg_pkg::BASE + off;
    constraint cfg.prio in [cfg_pkg::prio_e::MID, HIGH];
    exec body C = """
      /* setup {{comp.label}} */
      reg_write({{cfg.value}}, {{off}} + {{cfg.prio == HIGH ? 1 : 0}});
    """;
    exec body SV = """
      api.reg_write({{cfg.value}}, {{off}} + {{cfg.prio == HIGH ? 1 : 0}});
    """;
  }
  action use_cfg {
    input cfg_pkg::cfg_s cfg;
    rand int in [-8..8] delta;
    rand bit[3] n;
    constraint delta != 0;
    constraint (cfg.value >> 4) % 2 == 0 -> delta < 0;
    constraint n == (cfg.prio == HIGH ? 2 : 1);
    exec body {
      repeat (i : n) {
        note("use", delta * (i + 1));
      }
      note("twice", read_twice(cfg.value));
    }
  }
  action noop { }

  action entry {
    rand bit[2] count;
    setup s;
    use_cfg u1, u2;
    constraint count in [1..2];
    constraint u1.delta + u2.delta == 3;
    activity {
      s;
      schedule {
        u1;
        u2 with { n == 1; };
      }
      bind s.cfg u1.cfg u2.cfg;
      parallel {
        replicate (count) {
          do port_c::recv;
        }
      }
      repeat (i : 2) {
        if (i == 1) {
          select {
            [1]: do noop;
            [0]: do setup;
          }
        }
        do port_c::send with { out.hdr.len == 3 - i; };
      }
      constraint s.off > 0x100;
    }
  }
}
