# The tools on a real library: cells of SkyWater sky130 (lib/sky130).
#   cmake -DBIN=<build dir> -DSRC=<source dir> -DWORK=<dir> -DFULL=0|1 -P sky130.cmake
# FULL=1 uses the whole library from lib/sky130/pdk instead of the subset.
set(SKY ${SRC}/lib/sky130)
file(MAKE_DIRECTORY ${WORK})
function(run tool want_rc)
  execute_process(COMMAND ${BIN}/${tool} ${ARGN} WORKING_DIRECTORY ${WORK}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(out "${out}${err}" PARENT_SCOPE)
  if(NOT rc EQUAL ${want_rc})
    message(FATAL_ERROR "${tool} ${ARGN} exited ${rc}, expected ${want_rc}\n${out}${err}")
  endif()
endfunction()

if(FULL)
  set(LIB ${SKY}/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib)
  set(LEF ${SKY}/pdk/sky130_fd_sc_hd_merged.lef)
  set(TLEF ${SKY}/pdk/sky130_fd_sc_hd.tlef)
  set(CELLS 428)
else()
  set(LIB ${SKY}/sky130_hd_subset_tt.lib)
  set(LEF ${SKY}/sky130_hd_subset.lef)
  set(TLEF ${SKY}/sky130_hd.tlef)
  set(CELLS 47)
endif()

# 1. mlibc reads it. What it reports are facts about sky130, and nothing
#    else: a few negative delays, inv_1's pins off the track grid.
run(mlibc 0 check ${LIB} -lef ${TLEF} -lef ${LEF})
if(NOT out MATCHES ": ${CELLS} cells, [0-9]+ findings")
  message(FATAL_ERROR "mlibc check:\n${out}")
endif()
if(NOT out MATCHES "sky130_fd_sc_hd__inv_2: .LIB006. a negative delay or transition: cell_fall of A -> Y: -0.0275597 ns"
   OR NOT out MATCHES "sky130_fd_sc_hd__inv_1: .LEF005.")
  message(FATAL_ERROR "mlibc check: the known sky130 findings are missing:\n${out}")
endif()
foreach(rule LIB001 LIB002 LIB003 LIB004 LIB007 LIB008 LIB009 LIB011 LIB013 LEF001 LEF002 LEF003)
  if(out MATCHES "\\[${rule}\\]")
    message(FATAL_ERROR "mlibc check: ${rule} on sky130 would be a false alarm:\n${out}")
  endif()
endforeach()
run(mlibc 0 report ${LIB} -cell sky130_fd_sc_hd__dfrtp_1)
if(NOT out MATCHES "arc CLK -> D setup_rising" OR NOT out MATCHES "arc RESET_B -> Q clear")
  message(FATAL_ERROR "mlibc report -cell:\n${out}")
endif()
if(FULL)
  run(mlibc 0 compare ${SKY}/pdk/sky130_fd_sc_hd__ss_100C_1v60.lib ${SKY}/pdk/sky130_fd_sc_hd__ff_n40C_1v95.lib -Werror)
  if(NOT out MATCHES "428 cells, [0-9]+ arcs compared, slow/fast delay ratio [23]\\.[0-9]+, 0 findings")
    message(FATAL_ERROR "mlibc compare:\n${out}")
  endif()
endif()

# 2. RTL to sky130 gates, then timing and power on the netlist. These tools
#    need the slang front end: without them the test stops here.
if(NOT EXISTS ${BIN}/msynth OR NOT EXISTS ${BIN}/msta OR NOT EXISTS ${BIN}/mpower)
  message(STATUS "sky130: msynth, msta or mpower not built; library checks only")
  return()
endif()
run(msynth 0 ${SRC}/tests/sky130/alu.sv -top alu -lib ${LIB} -period 2 -clock clk -o ${WORK}/alu_net.v -q)
file(READ ${WORK}/alu_net.v net)
if(NOT net MATCHES "sky130_fd_sc_hd__dfrtp_1 " OR NOT net MATCHES "sky130_fd_sc_hd__nand2_1 ")
  message(FATAL_ERROR "msynth did not map to sky130 cells:\n${net}")
endif()
run(msta 0 -lib ${LIB} -sdc ${SRC}/tests/sky130/alu.sdc ${WORK}/alu_net.v)
if(NOT out MATCHES "sky130_fd_sc_hd__dfrtp_1" OR NOT out MATCHES "clk +max +[0-9.]+ +0.000 +0 +25")
  message(FATAL_ERROR "msta: setup is not met or the report changed:\n${out}")
endif()
run(mpower 0 -top alu -lib ${LIB} -clock clk 2 ${WORK}/alu_net.v)
if(NOT out MATCHES "library +sky130_fd_sc_hd__tt_025C_1v80, 1.8 V" OR NOT out MATCHES "total power [0-9.]+ uW")
  message(FATAL_ERROR "mpower:\n${out}")
endif()
