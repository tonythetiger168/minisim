# mdft scan compression self-test.
#   cmake -DMDFT=<mdft> -DMSIM=<msim> -DSRC=<source dir> -DOUT=<scratch dir> -P mdft_edt.cmake
set(T ${SRC}/tests/dft)
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})
function(run_ok)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY ${OUT} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(out "${out}${err}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${ARGV} exited ${rc}\n${out}${err}")
  endif()
endfunction()
function(simulate want)
  execute_process(COMMAND ${MSIM} ${ARGN} WORKING_DIRECTORY ${OUT} OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(FIND "${out}" "${want}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "msim ${ARGN}: expected '${want}'\n${out}${err}")
  endif()
endfunction()

# Hardware plus encoding of three cubes; the wrapper is simulated in shift mode.
run_ok(${MDFT} -edt ${T}/lbist/sdut.sv -top sdut -scandef ${T}/lbist/chains.json -edt_ring 16
       -edt_cubes ${T}/edt/cubes.txt -edt_patterns pat.txt)
if(NOT out MATCHES "2 chains \\(longest 5\\) on 1 channel, 16-bit ring generator, 21 shift cycles" OR
   NOT out MATCHES "3 of 3 cubes encoded \\(0 unencodable\\)")
  message(FATAL_ERROR "mdft -edt:\n${out}")
endif()
# Every load honours its cube.
file(STRINGS ${OUT}/pat.txt pat)
foreach(want "^0 load chain0 1.0.$" "^0 load chain1 ..1.0$" "^1 load chain0 0110$" "^1 load chain1 10101$" "^2 load chain0 ...1$")
  set(hit FALSE)
  foreach(line ${pat})
    if(line MATCHES "${want}")
      set(hit TRUE)
    endif()
  endforeach()
  if(NOT hit)
    message(FATAL_ERROR "pat.txt has no line matching ${want}\n${pat}")
  endif()
endforeach()
simulate("sdut_edt_tb: PASS (63 checks)" ${T}/lbist/sdut.sv sdut_edt.sv sdut_edt_tb.sv -top sdut_edt_tb)
# A decompressor with one phase-shifter tap moved fails the same testbench.
file(READ ${OUT}/sdut_edt.sv rtl)
string(REGEX REPLACE "assign scan_in\\[1\\] = \\^\\(gen & 16'h[0-9a-f]+\\);" "assign scan_in[1] = ^(gen & 16'h0007);" broken "${rtl}")
if(broken STREQUAL rtl)
  message(FATAL_ERROR "sdut_edt.sv: the phase shifter is not where the test expects it")
endif()
file(WRITE ${OUT}/broken.sv "${broken}")
simulate("sdut_edt_tb: FAIL" ${T}/lbist/sdut.sv broken.sv sdut_edt_tb.sv -top sdut_edt_tb)
# Cubes as matpg -cubes writes them: chains by number, mapped through the
# "chains" line by scan-in port, and port input lines passed through.
file(WRITE ${OUT}/num.txt "# cubes\nchains scan_in[1] scan_in[0]\n0 pi 0101\n0 0 1xx0x\n0 1 x01x\n")
run_ok(${MDFT} -edt_encode -scandef ${T}/lbist/chains.json -edt_cubes num.txt -edt_patterns num_pat.txt)
file(READ ${OUT}/num_pat.txt np)
if(NOT np MATCHES "0 pi 0101\n" OR NOT np MATCHES "0 load chain1 1[01][01]0[01]\n" OR NOT np MATCHES "0 load chain0 [01]01[01]\n")
  message(FATAL_ERROR "numbered chains: num_pat.txt:\n${np}")
endif()
file(WRITE ${OUT}/num2.txt "0 0 1xx0\n")
run_ok(${MDFT} -edt_encode -scandef ${T}/lbist/chains.json -edt_cubes num2.txt)
if(NOT out MATCHES "there is no 'chains' line")
  message(FATAL_ERROR "numbered chains without a chains line: no note:\n${out}")
endif()

# Without cubes the testbench plays random channel data.
run_ok(${MDFT} -edt ${T}/lbist/sdut.sv -top sdut -scandef ${T}/lbist/chains.json -edt_out . -quiet)
simulate("sdut_edt_tb: PASS" ${T}/lbist/sdut.sv sdut_edt.sv sdut_edt_tb.sv -top sdut_edt_tb)

# Encoding alone, on a larger chain plan: 1 thread and 4 threads agree, and a
# cube with more care bits than channel bits is reported as unencodable.
set(json "{\"top\":\"big\",\"scan_enable\":{\"port\":\"scan_en\",\"active\":\"high\"},\"clocks\":[{\"port\":\"clk\"}],\"chains\":[")
set(cubes "")
foreach(i RANGE 39)
  if(i GREATER 0)
    string(APPEND json ",")
  endif()
  string(APPEND json "{\"name\":\"c${i}\",\"scan_in\":\"si[${i}]\",\"scan_out\":\"so[${i}]\",\"length\":60}")
  # Three care bits per chain, spread over the shift cycles (a decompressor
  # only has as many free bits per cycle as it has channels).
  set(l0 "")
  set(l1 "")
  foreach(j RANGE 59)
    math(EXPR k0 "(${j} + ${i} * 3) % 20")
    math(EXPR k1 "(${j} + ${i} * 7) % 20")
    if(k0 EQUAL 0)
      string(APPEND l0 "1")
    else()
      string(APPEND l0 "x")
    endif()
    if(k1 EQUAL 5)
      string(APPEND l1 "0")
    else()
      string(APPEND l1 "x")
    endif()
  endforeach()
  string(APPEND cubes "0 c${i} ${l0}\n")
  string(APPEND cubes "1 c${i} ${l1}\n")
  string(REPEAT "10" 30 dense)
  string(APPEND cubes "2 c${i} ${dense}\n")
endforeach()
string(APPEND json "]}")
file(WRITE ${OUT}/big.json "${json}")
file(WRITE ${OUT}/big.txt "${cubes}")
run_ok(${MDFT} -edt_encode -scandef big.json -edt_cubes big.txt -edt_patterns p1.txt -threads 1)
if(NOT out MATCHES "40 chains \\(longest 60\\) on 4 channels" OR NOT out MATCHES "2 of 3 cubes encoded \\(1 unencodable\\)" OR
   NOT out MATCHES "on 1 thread\n")
  message(FATAL_ERROR "mdft -edt_encode:\n${out}")
endif()
run_ok(${MDFT} -edt_encode -scandef big.json -edt_cubes big.txt -edt_patterns p4.txt -threads 4)
file(READ ${OUT}/p1.txt p1)
file(READ ${OUT}/p4.txt p4)
if(NOT p1 STREQUAL p4 OR NOT p1 MATCHES "\n2 unencodable\n")
  message(FATAL_ERROR "the encoding depends on the thread count, or the dense cube was encoded")
endif()
execute_process(COMMAND ${MDFT} -edt_encode -scandef big.json -edt_cubes big.txt -edt_channels 40
                WORKING_DIRECTORY ${OUT} RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 2 OR NOT err MATCHES "-edt_channels must be 1 to 32")
  message(FATAL_ERROR "bad -edt_channels: rc=${rc} ${err}")
endif()
message(STATUS "mdft_edt: ok")
