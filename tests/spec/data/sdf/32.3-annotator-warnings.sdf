(DELAYFILE
  (SDFVERSION "3.0")
  (TIMESCALE 1ns)
  (CELL (CELLTYPE "bufp") (INSTANCE u1)
    (DELAY (ABSOLUTE (IOPATH A Z (3))
                     (IOPATH B Z (4)))))
  (CELL (CELLTYPE "bufp") (INSTANCE u9)
    (DELAY (ABSOLUTE (IOPATH A Z (5)))))
  (CELL (CELLTYPE "inv") (INSTANCE u2)
    (DELAY (ABSOLUTE (IOPATH A Z (6)))))
  (CELL (CELLTYPE "bufp") (INSTANCE u1)
    (TIMINGENV (PATHCONSTRAINT A Z (1) (2)))
    (TIMINGCHECK (SETUP A (posedge Z) (1))))
)
