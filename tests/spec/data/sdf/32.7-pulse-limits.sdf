(DELAYFILE
  (SDFVERSION "3.0")
  (TIMESCALE 1ns)
  (CELL (CELLTYPE "c0") (INSTANCE u1)
    (DELAY (ABSOLUTE (IOPATH a y (5)))))
  (CELL (CELLTYPE "c0") (INSTANCE u2)
    (DELAY (ABSOLUTE (IOPATH a y ((5) () ())))))
  (CELL (CELLTYPE "c6") (INSTANCE u3)
    (DELAY (INCREMENT (IOPATH a y (() (-4) (-5))))))
  (CELL (CELLTYPE "c0") (INSTANCE u4)
    (DELAY (ABSOLUTE
      (IOPATH a y (6))
      (PATHPULSE a y (1) (3)))))
  (CELL (CELLTYPE "c0") (INSTANCE u5)
    (DELAY (ABSOLUTE
      (IOPATH a y (8))
      (PATHPULSEPERCENT a y (25) (50)))))
  (CELL (CELLTYPE "c0") (INSTANCE u6)
    (DELAY (ABSOLUTE
      (PATHPULSE a y (1) (2))
      (IOPATH a y (10)))))
  (CELL (CELLTYPE "c0") (INSTANCE u7)
    (DELAY (ABSOLUTE (IOPATH a y ((10) (1) (2))))))
  (CELL (CELLTYPE "c0") (INSTANCE u8)
    (DELAY (ABSOLUTE
      (IOPATH a y (5))
      (PATHPULSE (20) (30)))))
)
