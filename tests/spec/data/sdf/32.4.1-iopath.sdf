(DELAYFILE
  (SDFVERSION "3.0")
  (DESIGN "top")
  (VENDOR "minisim tests")
  (DIVIDER /)
  (TIMESCALE 1ns)
  (CELL (CELLTYPE "plain") (INSTANCE u1)
    (DELAY (ABSOLUTE (IOPATH sel zout (1.3) (1.7)))))
  (CELL (CELLTYPE "twocond") (INSTANCE u2)
    (DELAY (ABSOLUTE (COND mode (IOPATH sel zout (1.2) (1.6))))))
  (CELL (CELLTYPE "twocond") (INSTANCE u3)
    (DELAY (ABSOLUTE (IOPATH sel zout (1.1) (1.9)))))
  (CELL (CELLTYPE "withnone") (INSTANCE u4)
    (DELAY (ABSOLUTE (CONDELSE (IOPATH sel zout (2) (3))))))
  (CELL (CELLTYPE "dev") (INSTANCE *)
    (DELAY (ABSOLUTE (DEVICE (4)))))
)
