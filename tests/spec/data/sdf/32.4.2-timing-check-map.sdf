(DELAYFILE
  (SDFVERSION "3.0")
  (TIMESCALE 1ns)
  (CELL (CELLTYPE "checks") (INSTANCE u)
    (TIMINGCHECK
      (SETUP d1 (posedge c1) (5))
      (HOLD d2 (posedge c2) (5))
      (SETUP d3 (posedge c3) (5))
      (HOLD d3 (posedge c3) (6))
      (RECOVERY (posedge r4) (posedge c4) (5))
      (REMOVAL (posedge r5) (posedge c5) (5))
      (RECREM (posedge r6) (posedge c6) (5) (6))
      (SKEW (posedge c7) (posedge d7) (2))
      (WIDTH (posedge w8) (5))
      (PERIOD (posedge p9) (5))
      (NOCHANGE (posedge n10) d10 (0) (2))
      (BIDIRECTSKEW (posedge a11) (posedge b11) (2) (2))
      (SKEW (posedge c12) (posedge d12) (2))))
)
