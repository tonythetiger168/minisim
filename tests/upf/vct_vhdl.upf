# Power intent for vct_vhdl.sv and vct_vhdl.vhd: VHDL std_logic ports on
# supply nets through the VHDL tables of Annex B (4.10, 6.14).
upf_version 4.0
set_design_top dut
create_power_domain PD_TOP -include_scope
create_power_domain PD_CORE -elements {u_core}
foreach s {VDD VSS} {
    create_supply_port $s
    create_supply_net $s
    connect_supply_net $s -ports $s
}
create_supply_net VREG
create_supply_net VSSR
connect_supply_net VREG -ports {u_ldo/vout} -vct VHDL_SL2UPF
connect_supply_net VSSR -ports {u_ldo/gnd_n} -vct VHDL_SL2UPF_GNDZERO
connect_supply_net VREG -ports {u_mac/VDD} -vct UPF2VHDL_SL
connect_supply_net VSS -ports {u_mac/VSSN} -vct UPF_GNDZERO2VHDL_SL
connect_supply_net VREG -ports {u_mac/TIEH} -vct VHDL_TIED_HI
connect_supply_net VREG -ports {u_mac/TIEL} -vct VHDL_TIED_LO
create_supply_set SS_TOP -function {power VDD} -function {ground VSS}
create_supply_set SS_CORE -function {power VREG} -function {ground VSS}
associate_supply_set SS_TOP -handle PD_TOP.primary
associate_supply_set SS_CORE -handle PD_CORE.primary
