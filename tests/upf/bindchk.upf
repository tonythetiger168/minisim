# Power intent for bindchk.sv: bind_checker (6.12).
upf_version 4.0
set_design_top dut
create_power_domain PD_TOP -include_scope
create_power_domain PD_CORE -elements {u_core}
create_supply_port VDD
create_supply_port VSW
create_supply_port VSS
create_supply_net VDD
create_supply_net VSW
create_supply_net VSS
connect_supply_net VDD -ports {VDD}
connect_supply_net VSW -ports {VSW}
connect_supply_net VSS -ports {VSS}
create_supply_set SS -function {power VDD} -function {ground VSS}
create_supply_set SS_SW -function {power VSW} -function {ground VSS}
associate_supply_set SS -handle PD_TOP.primary
associate_supply_set SS_SW -handle PD_CORE.primary

# one checker in the top scope, on the core's output
bind_checker chk_q -module pwr_chk -ports {{clk clk} {v q} {en on}} -parameters {{NAME "q"} {W 4}}
# one in every leaf, on its own output
bind_checker chk_leaf -module pwr_chk -bind_to leaf -ports {{clk clk} {v q} {en 1'b1}} -parameters {{NAME "leaf"} {W 4}}
