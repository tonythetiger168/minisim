# Power intent for simctl.sv: sim_corruption_control (6.59),
# sim_assertion_control (6.58) and load_simstate_behavior (6.34).
upf_version 4.0
set_design_top dut
create_power_domain PD_TOP -include_scope
create_power_domain PD_SW -elements {u_r u_c u_k u_m}
create_supply_port VDD
create_supply_port VDD_SW
create_supply_port VSS
create_supply_net VDD
create_supply_net VDD_SW
create_supply_net VSS
connect_supply_net VDD -ports {VDD}
connect_supply_net VDD_SW -ports {VDD_SW}
connect_supply_net VSS -ports {VSS}
create_supply_set SS -function {power VDD} -function {ground VSS}
create_supply_set SS_SW -function {power VDD_SW} -function {ground VSS}
associate_supply_set SS -handle PD_TOP.primary
associate_supply_set SS_SW -handle PD_SW.primary

# reals of the model and integers of the counter keep their values
sim_corruption_control -type real -model rmodel
sim_corruption_control -type integer -elements {u_c}

# a_known: suspended while PD_SW is off (and fails after, q is x until reset)
sim_assertion_control -elements {u_k/a_known} -type suspend
# a_kill: never checked again once PD_SW goes off
sim_assertion_control -elements {u_k/a_kill} -type kill -controlling_domain PD_SW
# a_expr: off while the testbench says so
sim_assertion_control -model chk -elements {a_expr} -control_expr {quiet}

# the library's simstate behavior file: beh is a power-aware model
load_simstate_behavior mylib -file simctl_lib.upf
