/* A few cells with their own names and pin names, to check that matpg takes
   a cell's function, its scan pins and its reset from Liberty. */
library(tiny) {
  cell(ND2X1) {
    pin(A1) { direction: input; }
    pin(A2) { direction: input; }
    pin(ZN) { direction: output; function: "(A1 A2)'"; }
  }
  cell(INVX1) {
    pin(I) { direction: input; }
    pin(ZN) { direction: output; function: "!I"; }
  }
  cell(FAX1) {
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(CI) { direction: input; }
    pin(S) { direction: output; function: "A^B^CI"; }
    pin(CO) { direction: output; function: "(A B)+(A CI)+(B CI)"; }
  }
  cell(MX2X1) {
    pin(I0) { direction: input; }
    pin(I1) { direction: input; }
    pin(S) { direction: input; }
    pin(Z) { direction: output; function: "(I0 S')+(I1 S)"; }
  }
  cell(SDFRQX1) {
    ff(IQ, IQN) { clocked_on: "CP"; next_state: "(TE TI)+(TE' D)"; clear: "RDN'"; }
    pin(D) { direction: input; }
    pin(TI) { direction: input; }
    pin(TE) { direction: input; }
    pin(CP) { direction: input; clock: true; }
    pin(RDN) { direction: input; }
    pin(Q) { direction: output; function: "IQ"; }
    pin(QN) { direction: output; function: "IQN"; }
    test_cell() {
      pin(D) { direction: input; }
      pin(TI) { direction: input; signal_type: test_scan_in; }
      pin(TE) { direction: input; signal_type: test_scan_enable; }
      pin(CP) { direction: input; }
      pin(RDN) { direction: input; }
      ff(IQ, IQN) { clocked_on: "CP"; next_state: "D"; clear: "RDN'"; }
      pin(Q) { direction: output; function: "IQ"; signal_type: test_scan_out; }
      pin(QN) { direction: output; function: "IQN"; }
    }
  }
}
