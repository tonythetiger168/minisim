# SKY130 connectivity and transistors for mpv lvs (1.8 V devices of the
# sky130_fd_sc_hd standard cells).

layer nwell  64/20
layer diff   65/20
layer tap    65/44
layer poly   66/20
layer licon  66/44
layer li     67/20
layer mcon   67/44
layer met1   68/20
layer via    68/44
layer met2   69/20
layer hvtp   78/44

pwell  = extent() - nwell          # the substrate
ndiff  = diff - nwell
pdiff  = diff & nwell
ngate  = poly & ndiff
pgate  = poly & pdiff - hvtp
pgate_hvt = poly & pdiff & hvtp
nsd    = ndiff - poly
psd    = pdiff - poly
ptap   = tap - nwell
ntap   = tap & nwell

connect nsd licon
connect psd licon
connect ptap licon
connect ntap licon
connect poly licon
connect licon li
connect li met1 by mcon
connect met1 met2 by via
connect ptap pwell
connect ntap nwell

label li    67/5 67/16
label met1  68/5 68/16
label met2  69/5 69/16
label nwell 64/5 64/16
label pwell 64/59 122/16

device mos sky130_fd_pr__nfet_01v8     gate=ngate     poly=poly sd=nsd bulk=pwell
device mos sky130_fd_pr__pfet_01v8     gate=pgate     poly=poly sd=psd bulk=nwell
device mos sky130_fd_pr__pfet_01v8_hvt gate=pgate_hvt poly=poly sd=psd bulk=nwell
