# A tiny deck for tests/mpv.cmake: one metal, one via, a boundary layer.
layer metal  1
layer via    2
layer border 3

rule M.W   width(metal) < 0.14           "metal width"
rule M.S   space(metal) < 0.14           "metal spacing"
rule M.A   area(metal) < 0.083           "metal area"
rule V.SZ  not_rect(via, 0.17, 0.17)     "via must be 0.17 x 0.17"
rule V.E   enclosure(via, metal) < 0.03  "metal enclosure of via"
rule M.D   density(metal, 5) < 0.3       "metal density in 5 um windows"
