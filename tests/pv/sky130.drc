# A subset of the SkyWater SKY130 periphery rules (front end to metal 2), for
# mpv drc. Rule names and values follow the public SkyWater PDK documentation.
# Lengths in microns, areas in square microns.

layer nwell   64/20
layer diff    65/20
layer tap     65/44
layer poly    66/20
layer licon   66/44
layer li      67/20
layer mcon    67/44
layer met1    68/20
layer via     68/44
layer met2    69/20
layer stdcell 81/4      # areaid.standardc: standard cells have their own licon.11 value

difftap  = diff | tap
gate     = poly & diff
fieldpoly = poly - diff
licon_diff = licon & difftap
licon_poly = licon & poly

rule nwell.1    width(nwell) < 0.84          "nwell width"
rule nwell.2a   space(nwell) < 1.27          "nwell spacing"
rule difftap.1  width(difftap) < 0.15        "diff or tap width"
rule difftap.3  space(difftap) < 0.27        "diff or tap spacing"
rule poly.1a    width(poly) < 0.15           "poly width"
rule poly.2     space(poly) < 0.21           "poly spacing"
rule poly.4     space(fieldpoly, diff) < 0.075  "poly on field to diff spacing"
rule poly.5     space(fieldpoly, tap) < 0.055   "poly on field to tap spacing"
rule poly.7     overhang(diff, poly) < 0.25  "diff extension beyond the gate"
rule poly.8     overhang(poly, diff) < 0.13  "poly end cap beyond diff"
rule licon.1    not_rect(licon, 0.17, 0.17)  "licon must be 0.17 x 0.17"
rule licon.2    space(licon) < 0.17          "licon spacing"
rule licon.5a   enclosure(licon & diff, difftap) < 0.04   "diff enclosure of licon"
rule licon.5c   enclosure(licon & diff, difftap, opposite) < 0.06  "diff enclosure of licon on two opposite sides"
rule licon.8    enclosure(licon_poly, poly) < 0.05        "poly enclosure of licon"
rule licon.11   space(licon_diff - stdcell, gate) < 0.055  "licon on diff to gate spacing"
rule licon.11a  space(licon_diff & stdcell, gate) < 0.05   "licon on diff to gate spacing in a standard cell"
rule licon.x    licon - (difftap | poly)     "licon must be on diff, tap or poly"
rule li.1       width(li) < 0.17             "li width"
rule li.3       space(li) < 0.17             "li spacing"
rule li.x       licon - li                   "licon must be covered by li"
rule li.5       enclosure(licon, li, opposite) < 0.08  "li enclosure of licon on two opposite sides"
rule li.6       area(li) < 0.0561            "li area"
rule mcon.1     not_rect(mcon, 0.17, 0.17)   "mcon must be 0.17 x 0.17"
rule mcon.2     space(mcon) < 0.19           "mcon spacing"
rule mcon.x     mcon - li                    "mcon must be on li"
rule m1.1       width(met1) < 0.14           "met1 width"
rule m1.2       space(met1) < 0.14           "met1 spacing"
rule m1.4       enclosure(mcon, met1) < 0.03 "met1 enclosure of mcon"
rule m1.5       enclosure(mcon, met1, opposite) < 0.06  "met1 enclosure of mcon on two opposite sides"
rule m1.6       area(met1) < 0.083           "met1 area"
rule via.1a     not_rect(via, 0.15, 0.15)    "via must be 0.15 x 0.15"
rule via.2      space(via) < 0.17            "via spacing"
rule via.4a     enclosure(via, met1) < 0.055 "met1 enclosure of via"
rule via.5a     enclosure(via, met1, opposite) < 0.085  "met1 enclosure of via on two opposite sides"
rule m2.1       width(met2) < 0.14           "met2 width"
rule m2.2       space(met2) < 0.14           "met2 spacing"
rule m2.4       enclosure(via, met2) < 0.055 "met2 enclosure of via"
rule m2.5       enclosure(via, met2, opposite) < 0.085  "met2 enclosure of via on two opposite sides"
rule m2.6       area(met2) < 0.0676          "met2 area"
