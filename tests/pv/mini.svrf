// mini.drc in the SVRF style, for tests/mpv.cmake. Layer numbers without a
// LAYER MAP take every datatype.
LAYER metal 1
LAYER via 2
LAYER border 3

M.W { @ metal width
      INT metal < 0.14 }
M.S { @ metal spacing
      EXT metal < 0.14 }
M.A { @ metal area
      AREA metal < 0.083 }
V.E { @ metal enclosure of via
      ENC via metal < 0.03 }
M.D { @ metal density in 5 um windows
      DENSITY metal < 0.3 WINDOW 5 }
