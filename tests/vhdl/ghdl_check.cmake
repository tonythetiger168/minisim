# Re-makes a golden file with GHDL (GPL; run as an external program only) and
# checks it is unchanged. Skipped (exit code 77 maps to "skipped") without GHDL.
find_program(GHDL ghdl)
if(NOT GHDL)
  message("ghdl not installed: skipped")
  return()
endif()
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})
foreach(f ${FILES} ${DATA})
  file(COPY ${SRC}/${f} DESTINATION ${OUT})
endforeach()
execute_process(COMMAND ${GHDL} -a --std=08 ${FILES} WORKING_DIRECTORY ${OUT} RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "ghdl -a: ${err}")
endif()
execute_process(COMMAND ${GHDL} -e --std=08 ${TOP} WORKING_DIRECTORY ${OUT} RESULT_VARIABLE rc ERROR_VARIABLE err)
execute_process(COMMAND ${GHDL} -r --std=08 ${TOP} WORKING_DIRECTORY ${OUT} OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(REGEX REPLACE "simulation finished[^\n]*\n" "" out "${out}")
string(REGEX REPLACE "ghdl:error:[^\n]*\n" "" out "${out}")
file(READ ${SRC}/${TOP}.out want)
if(NOT out STREQUAL want)
  message(FATAL_ERROR "GHDL output differs from ${TOP}.out\n--- ghdl:\n${out}\n--- golden:\n${want}")
endif()
