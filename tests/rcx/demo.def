VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN demo ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 12000 4200 ) ;
COMPONENTS 4 ;
  - u1 INV + PLACED ( 1000 1400 ) N ;
  - u2 INV + PLACED ( 9000 1400 ) N ;
  - u3 INV + PLACED ( 1000 0 ) FS ;
  - u4 INV + PLACED ( 9000 0 ) FS ;
END COMPONENTS
PINS 3 ;
  - in + NET in + DIRECTION INPUT + USE SIGNAL + LAYER metal1 ( -50 -50 ) ( 50 50 ) + PLACED ( 0 2100 ) N ;
  - in2 + NET in2 + DIRECTION INPUT + USE SIGNAL + LAYER metal1 ( -50 -50 ) ( 50 50 ) + PLACED ( 0 700 ) N ;
  - out[0] + NET out[0] + DIRECTION OUTPUT + USE SIGNAL + LAYER metal2 ( -50 -50 ) ( 50 50 ) + PLACED ( 11000 4200 ) N ;
END PINS
SPECIALNETS 2 ;
  - VDD ( * VDD ) + USE POWER
    + ROUTED metal1 100 + SHAPE FOLLOWPIN ( 0 2750 ) ( 12000 * ) ;
  - VSS ( * VSS ) + USE GROUND
    + ROUTED metal1 100 + SHAPE FOLLOWPIN ( 0 1400 ) ( 12000 * ) ;
END SPECIALNETS
NETS 5 ;
  - in ( PIN in ) ( u1 A ) + USE SIGNAL
    + ROUTED metal1 ( 0 2100 ) ( 1100 * ) ;
  - n1 ( u1 Y ) ( u2 A ) + USE SIGNAL
    + ROUTED metal1 ( 1500 2300 ) ( 9100 * )
      NEW metal1 ( 9100 2300 ) ( * 2100 ) ;
  - n2 ( u3 Y ) ( u4 A ) + USE SIGNAL
    + ROUTED metal1 ( 1500 2500 ) ( 9100 * )
      NEW metal2 ( 1500 700 ) ( * 2500 ) via1_0
      NEW metal2 ( 1500 700 ) via1_0
      NEW metal2 ( 9100 700 ) ( * 2500 ) via1_0
      NEW metal2 ( 9100 700 ) via1_0 ;
  - in2 ( PIN in2 ) ( u3 A ) + USE SIGNAL
    + ROUTED metal1 ( 0 700 ) ( 1100 * ) ;
  - out[0] ( u2 Y ) ( PIN out[0] ) + USE SIGNAL
    + ROUTED metal1 ( 9500 2000 ) ( 11000 * ) via1_0
      NEW metal2 ( 11000 2000 ) ( * 4200 ) ;
END NETS
END DESIGN
