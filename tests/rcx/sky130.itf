$ SkyWater sky130 metal stack for mrcx: layer heights, thicknesses and sheet and via
$ resistances as published with the open-source PDK (github.com/google/skywater-pdk).
$ Dielectric constants are per-level averages.
TECHNOLOGY = sky130
GLOBAL_TEMPERATURE = 25
DIELECTRIC top   { THICKNESS = 2.00   ER = 3.9 }
CONDUCTOR met5   { THICKNESS = 1.26   WMIN = 1.6  SMIN = 1.6  RPSQ = 0.0285 }
DIELECTRIC imd4  { THICKNESS = 1.35   ER = 4.2 }
CONDUCTOR met4   { THICKNESS = 0.845  WMIN = 0.3  SMIN = 0.3  RPSQ = 0.047 }
DIELECTRIC imd3  { THICKNESS = 1.235  ER = 4.2 }
CONDUCTOR met3   { THICKNESS = 0.845  WMIN = 0.3  SMIN = 0.3  RPSQ = 0.047 }
DIELECTRIC imd2  { THICKNESS = 0.78   ER = 4.3 }
CONDUCTOR met2   { THICKNESS = 0.36   WMIN = 0.14 SMIN = 0.14 RPSQ = 0.125 }
DIELECTRIC imd1  { THICKNESS = 0.63   ER = 4.3 }
CONDUCTOR met1   { THICKNESS = 0.36   WMIN = 0.14 SMIN = 0.14 RPSQ = 0.125 }
DIELECTRIC lint  { THICKNESS = 0.44   ER = 4.4 }
CONDUCTOR li1    { THICKNESS = 0.10   WMIN = 0.17 SMIN = 0.17 RPSQ = 12.2 }
DIELECTRIC psg   { THICKNESS = 0.9361 ER = 4.5 }
VIA mcon { FROM = li1  TO = met1 RPV = 9.3 }
VIA via  { FROM = met1 TO = met2 RPV = 4.5 }
VIA via2 { FROM = met2 TO = met3 RPV = 3.41 }
VIA via3 { FROM = met3 TO = met4 RPV = 3.41 }
VIA via4 { FROM = met4 TO = met5 RPV = 0.38 }
