/* Template for tests/char/rc.sp. The numbers in the tables are placeholders:
   mchar replaces them. */
library (rc) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1, ff);
  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_fall : 80;
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  nom_process : 1;
  nom_voltage : 1.0;
  nom_temperature : 25;
  operating_conditions (typ) { process : 1; voltage : 1.0; temperature : 25; }
  default_operating_conditions : typ;
  lu_table_template (d) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.0006, 0.0012");
    index_2 ("10, 20");
  }
  cell (RCINV) {
    area : 1;
    pin (A) { direction : input; capacitance : 1; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (d) { values ("0, 0", "0, 0"); }
        rise_transition (d) { values ("0, 0", "0, 0"); }
        cell_fall (d) { values ("0, 0", "0, 0"); }
        fall_transition (d) { values ("0, 0", "0, 0"); }
      }
    }
  }
  cell (NOCELL) {
    area : 1;
    pin (A) { direction : input; capacitance : 1; }
    pin (Y) { direction : output; function : "A"; }
  }
}
