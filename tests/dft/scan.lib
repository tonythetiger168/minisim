/* A small Liberty library for the mdft -insert_scan -lib test: plain flops,
   their scan equivalents (test_cell), a mux, a latch and a clock gate. */
library (scan_test) {
  time_unit : "1ns";
  capacitive_load_unit (1, pf);
  cell (DFF) {
    area : 4;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "D"; }
    pin (D) { direction : input; }
    pin (CK) { direction : input; clock : true; }
    pin (Q) { direction : output; function : "IQ"; }
  }
  cell (DFFN) {
    area : 4;
    ff (IQ, IQN) { clocked_on : "!CKN"; next_state : "D"; }
    pin (D) { direction : input; }
    pin (CKN) { direction : input; clock : true; }
    pin (Q) { direction : output; function : "IQ"; }
  }
  cell (DFFR) {
    area : 5;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "D"; clear : "!RN"; }
    pin (D) { direction : input; }
    pin (CK) { direction : input; clock : true; }
    pin (RN) { direction : input; }
    pin (Q) { direction : output; function : "IQ"; }
  }
  cell (DFFE) {
    area : 6;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "(E & D) | (!E & IQ)"; }
    pin (D) { direction : input; }
    pin (E) { direction : input; }
    pin (CK) { direction : input; clock : true; }
    pin (Q) { direction : output; function : "IQ"; }
  }
  cell (SDFF) {
    area : 6;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "(SE & SI) | (!SE & D)"; }
    pin (D) { direction : input; }
    pin (SI) { direction : input; }
    pin (SE) { direction : input; }
    pin (CK) { direction : input; clock : true; }
    pin (Q) { direction : output; function : "IQ"; }
    test_cell () {
      ff (IQ, IQN) { clocked_on : "CK"; next_state : "D"; }
      pin (D) { direction : input; }
      pin (SI) { direction : input; signal_type : "test_scan_in"; }
      pin (SE) { direction : input; signal_type : "test_scan_enable"; }
      pin (CK) { direction : input; }
      pin (Q) { direction : output; function : "IQ"; signal_type : "test_scan_out"; }
    }
  }
  cell (SDFFR) {
    area : 7;
    ff (IQ, IQN) { clocked_on : "CK"; next_state : "(SE & SI) | (!SE & D)"; clear : "!RN"; }
    pin (D) { direction : input; }
    pin (SI) { direction : input; }
    pin (SE) { direction : input; }
    pin (CK) { direction : input; clock : true; }
    pin (RN) { direction : input; }
    pin (Q) { direction : output; function : "IQ"; }
    test_cell () {
      ff (IQ, IQN) { clocked_on : "CK"; next_state : "D"; clear : "!RN"; }
      pin (D) { direction : input; }
      pin (SI) { direction : input; signal_type : "test_scan_in"; }
      pin (SE) { direction : input; signal_type : "test_scan_enable"; }
      pin (CK) { direction : input; }
      pin (RN) { direction : input; }
      pin (Q) { direction : output; function : "IQ"; signal_type : "test_scan_out"; }
    }
  }
  cell (MUX2) {
    area : 3;
    pin (A) { direction : input; }
    pin (B) { direction : input; }
    pin (S) { direction : input; }
    pin (Y) { direction : output; function : "(S & B) | (!S & A)"; }
  }
  cell (BUF) { area : 1; pin (A) { direction : input; } pin (Y) { direction : output; function : "A"; } }
  cell (INV) { area : 1; pin (A) { direction : input; } pin (Y) { direction : output; function : "!A"; } }
  cell (XOR2) {
    area : 2;
    pin (A) { direction : input; } pin (B) { direction : input; }
    pin (Y) { direction : output; function : "A ^ B"; }
  }
  cell (AND2) {
    area : 2;
    pin (A) { direction : input; } pin (B) { direction : input; }
    pin (Y) { direction : output; function : "A & B"; }
  }
  cell (LATCH) {
    area : 3;
    latch (IQ, IQN) { enable : "G"; data_in : "D"; }
    pin (D) { direction : input; }
    pin (G) { direction : input; }
    pin (Q) { direction : output; function : "IQ"; }
  }
  cell (ICG) {
    area : 5;
    clock_gating_integrated_cell : "latch_posedge_precontrol";
    pin (CK) { direction : input; clock : true; clock_gate_clock_pin : true; }
    pin (E) { direction : input; clock_gate_enable_pin : true; }
    pin (TE) { direction : input; clock_gate_test_pin : true; }
    pin (GCK) { direction : output; clock_gate_out_pin : true; }
  }
}
