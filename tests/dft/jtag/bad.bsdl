-- Every rule of the BSDL checker fires on this file.
entity bad is
  generic (PHYSICAL_PIN_MAP : string := "PKG");
  port (
    a : in bit_vector(1 downto 0);
    y : out bit;
    io : inout bit;
    nc : in bit;
    vdd : linkage bit;
    tck : in bit;
    tms : in bit;
    tdi : in bit;
    tdo : in bit);
  use STD_1149_1_2001.all;
  attribute PIN_MAP of bad : entity is PHYSICAL_PIN_MAP;
  constant PKG : PIN_MAP_STRING :=
    "a : (1, 2, 3)," & "y : 4," & "io : 5," & "nc : 6," & "vdd : 7," &
    "tck : 8," & "tms : 9," & "tdi : 10";
  attribute TAP_SCAN_IN of tdi : signal is true;
  attribute TAP_SCAN_MODE of tms : signal is true;
  attribute TAP_SCAN_OUT of tdo : signal is true;
  attribute TAP_SCAN_CLOCK of tck : signal is (10.0e6, BOTH);
  attribute INSTRUCTION_LENGTH of bad : entity is 3;
  attribute INSTRUCTION_OPCODE of bad : entity is
    "EXTEST (000)," & "SAMPLE (001)," & "IDCODE (001)," & "USER (10)," & "BYPASS (110)";
  attribute INSTRUCTION_CAPTURE of bad : entity is "010";
  attribute IDCODE_REGISTER of bad : entity is "0000" & "0000000000000001" & "00000000001" & "0";
  attribute BOUNDARY_LENGTH of bad : entity is 7;
  attribute BOUNDARY_REGISTER of bad : entity is
    "0 (BC_1, a(0), input, X)," &
    "1 (BC_1, a(2), input, X)," &
    "2 (BC_1, a(1), output2, X)," &
    "3 (BC_1, io, output3, X)," &
    "4 (BC_1, y, output3, X, 0, 1, Z)," &
    "5 (BC_1, vdd, input, X)," &
    "7 (BC_1, ghost, input, X)";
end bad;
