iProcsForModule Sensor
iProc measure {m {loops 10}} {
  iWrite en 1
  iWrite mode $m
  iApply
  iRunLoop $loops
  iRead done 1
  iRead temp 0b10110
  iApply
  iWrite en 0
  iApply
}
iProcsForModule Sub
iProc setmode {m} {
  iWrite cfg $m
  iApply
  iRead cfg $m
  iApply
}
iProcsForModule Top
iProc all {} {
  iNote "sensor"
  iCall sens.measure 2
  iCall sub.setmode fast
  iWrite sub.low 0x5
  iApply
  iRead sub.cfg 0xF5
  for {set i 0} {$i < 2} {incr i} { iWrite tdr1.R[[expr {$i + 6}]] 1 }
  iWrite strap 0b10
  iRead tdr1.R[1:0] 0b10
  iApply
  iReset
  iRead sub.cfg 0x3C
  iApply
}
