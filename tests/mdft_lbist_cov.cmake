# mdft logic BIST coverage self-test: the patterns the BIST controller applies
# are graded on the gate netlist, and the grade is checked against the real
# wrapper in simulation: a fault graded detected changes the signature, a
# fault graded not detected leaves it alone.
#   cmake -DMDFT=<mdft> -DMSIM=<msim> -DSRC=<source dir> -DOUT=<scratch dir> -P mdft_lbist_cov.cmake
set(T ${SRC}/tests/atpg)
set(SD ${SRC}/tests/dft/lbist/scan_chains.json)
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})
function(run)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY ${OUT} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(out "${out}${err}" PARENT_SCOPE)
  set(rc ${rc} PARENT_SCOPE)
endfunction()
function(run_ok)
  run(${ARGV})
  set(out "${out}" PARENT_SCOPE)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${ARGV} exited ${rc}\n${out}")
  endif()
endfunction()

set(C ${MDFT} -lbist_coverage -scandef ${SD} ${T}/scan.v -lbist_patterns 300)
run_ok(${C} -lbist_faults faults.txt -lbist_json cov.json -threads 1)
foreach(want "300 patterns, 2 chains, 8 scan cells observed" "test coverage +[0-9.]+%" "coverage by pattern count:  64: [0-9.]+%  128: [0-9.]+%  256: [0-9.]+%  300: [0-9.]+%")
  if(NOT out MATCHES "${want}")
    message(FATAL_ERROR "no '${want}' in:\n${out}")
  endif()
endforeach()
string(REGEX REPLACE "[^\n]* s on [^\n]*\n" "" one "${out}")
run_ok(${C} -threads 4)
string(REGEX REPLACE "[^\n]* s on [^\n]*\n" "" four "${out}")
if(NOT one STREQUAL four)
  message(FATAL_ERROR "1 and 4 threads differ:\n${one}\n${four}")
endif()
file(READ ${OUT}/cov.json json)
if(NOT json MATCHES "\"curve\": \\[\\[64, " OR NOT json MATCHES "\"unknown_captures\": 0")
  message(FATAL_ERROR "cov.json:\n${json}")
endif()
# The gate and its error exit.
run(${C} -lbist_min_coverage 99.9)
if(NOT rc EQUAL 1 OR NOT out MATCHES "is under 99.9")
  message(FATAL_ERROR "-lbist_min_coverage: exit ${rc}\n${out}")
endif()
file(WRITE ${OUT}/short.json "{\"top\":\"scan\",\"scan_enable\":{\"port\":\"scan_en\",\"active\":\"high\"},\"clocks\":[{\"port\":\"clk\",\"off_state\":0,\"flops\":8}],\"resets\":[],\"chains\":[{\"name\":\"c0\",\"scan_in\":\"scan_in[0]\",\"scan_out\":\"scan_out[0]\",\"length\":3},{\"name\":\"c1\",\"scan_in\":\"scan_in[1]\",\"scan_out\":\"scan_out[1]\",\"length\":4}],\"unscanned\":[]}\n")
run(${MDFT} -lbist_coverage -scandef short.json ${T}/scan.v)
if(NOT rc EQUAL 2 OR NOT out MATCHES "chain c0 has 4 cells in the netlist, 3 in the scan description")
  message(FATAL_ERROR "short.json: exit ${rc}\n${out}")
endif()

# Against the wrapper in simulation.
set(L ${MDFT} -lbist ${T}/scan.v ${T}/generic_cells.v -top scan -scandef ${SD} -lbist_patterns 300)
run_ok(${L} -lbist_sign -lbist_msim ${MSIM})
if(NOT out MATCHES "golden signature ([0-9a-f]+)")
  message(FATAL_ERROR "no golden signature:\n${out}")
endif()
file(READ ${T}/scan.v net)
file(STRINGS ${OUT}/faults.txt lines REGEX "^sa[01]  (DS|ND)  U[0-9]+/Y$")
set(nd 0)
set(nn 0)
foreach(l ${lines})
  string(REGEX MATCH "^sa([01])  (DS|ND)  U([0-9]+)/Y$" m "${l}")
  set(v ${CMAKE_MATCH_1})
  set(cls ${CMAKE_MATCH_2})
  set(g ${CMAKE_MATCH_3})
  if((cls STREQUAL DS AND nd GREATER 5) OR (cls STREQUAL ND AND nn GREATER 5))
    continue()
  endif()
  string(REPLACE ".Y(n${g}));" ".Y(n${g}_cut));\n  assign n${g} = 1'b${v};" bad "${net}")
  string(REPLACE "  wire q0;" "  wire n${g}_cut;\n  wire q0;" bad "${bad}")
  file(WRITE ${OUT}/bad.v "${bad}")
  run(${MSIM} bad.v ${T}/generic_cells.v scan_lbist.sv scan_lbist_tb.sv -top scan_lbist_tb)
  if(cls STREQUAL DS)
    math(EXPR nd "${nd} + 1")
    if(NOT out MATCHES "scan_lbist_tb: FAIL")
      message(FATAL_ERROR "sa${v} U${g}/Y is graded detected but the BIST passes:\n${out}")
    endif()
  else()
    math(EXPR nn "${nn} + 1")
    if(NOT out MATCHES "scan_lbist_tb: PASS")
      message(FATAL_ERROR "sa${v} U${g}/Y is graded not detected but the BIST fails:\n${out}")
    endif()
  endif()
endforeach()
if(nd LESS 3 OR nn LESS 3)
  message(FATAL_ERROR "too few faults simulated: ${nd} detected, ${nn} not detected")
endif()
message(STATUS "mdft_lbist_cov: ok (${nd} detected and ${nn} undetected faults confirmed in simulation)")
