# VCD tasks (21.7.1): without -vcd, $dumpvars writes $dumpfile's file with
# only the selected signals, and $dumpoff / $dumpon / $dumpall add their
# blocks. With -vcd, every signal is dumped to the -vcd file instead.
set(dir ${CMAKE_CURRENT_BINARY_DIR}/msim_vcdtasks_test)
file(REMOVE_RECURSE ${dir})
file(MAKE_DIRECTORY ${dir})
set(sv ${SRC}/tests/spec/21.7-vcd-tasks.sv)
execute_process(COMMAND ${MSIM} ${sv} WORKING_DIRECTORY ${dir} RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "msim exited ${rc}")
endif()
if(NOT EXISTS ${dir}/spec_21_7.vcd)
  message(FATAL_ERROR "$dumpfile's spec_21_7.vcd not written")
endif()
file(READ ${dir}/spec_21_7.vcd vcd)
foreach(want "$scope module tb $end" "$scope module u1 $end" " other $end" " r $end" " c $end"
             "#0\n$dumpvars\n" "#20\n$dumpoff\nbxxxxxxxx " "#40\n$dumpon\n" "#50\n$dumpall\n")
  string(FIND "${vcd}" "${want}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "spec_21_7.vcd lacks '${want}':\n${vcd}")
  endif()
endforeach()
# Not selected: tb's own clk and q (levels 1 of u1 and the variable other).
foreach(bad " clk $end" "#25\n")
  string(FIND "${vcd}" "${bad}" pos)
  if(NOT pos EQUAL -1)
    message(FATAL_ERROR "spec_21_7.vcd has '${bad}':\n${vcd}")
  endif()
endforeach()

file(REMOVE ${dir}/spec_21_7.vcd)
execute_process(COMMAND ${MSIM} ${sv} -vcd all.vcd WORKING_DIRECTORY ${dir} RESULT_VARIABLE rc OUTPUT_QUIET)
if(EXISTS ${dir}/spec_21_7.vcd)
  message(FATAL_ERROR "-vcd should override $dumpfile")
endif()
file(READ ${dir}/all.vcd vcd)
foreach(want " clk $end" " other $end" "$dumpoff" "$dumpon")
  string(FIND "${vcd}" "${want}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "all.vcd lacks '${want}'")
  endif()
endforeach()

# $dumplimit: dumping stops once the file reaches the limit.
file(WRITE ${dir}/lim.sv "module t; logic [7:0] c = 0; initial begin $dumpvars; $dumplimit(300); repeat (100) #1 c++; end endmodule\n")
execute_process(COMMAND ${MSIM} lim.sv WORKING_DIRECTORY ${dir} RESULT_VARIABLE rc OUTPUT_QUIET)
file(READ ${dir}/dump.vcd vcd)
string(FIND "${vcd}" "$dumplimit reached" pos)
string(FIND "${vcd}" "#99\n" late)
if(pos EQUAL -1 OR NOT late EQUAL -1)
  message(FATAL_ERROR "$dumplimit not honoured:\n${vcd}")
endif()
