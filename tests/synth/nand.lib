/* A minimal library for the msynth tests: an inverter, a 2-input NAND and
   one flop with an active-low asynchronous clear. No timing tables. Every
   other gate, falling-edge flops and preset flops have to be built from these. */
library (nand_only) {
  time_unit : "1ns";
  capacitive_load_unit (1, pf);
  cell (NOT1) {
    area : 1;
    pin (I) { direction : input; capacitance : 0.001; }
    pin (ZN) { direction : output; function : "I'"; }
  }
  cell (ND2) {
    area : 2;
    pin (A1) { direction : input; capacitance : 0.001; }
    pin (A2) { direction : input; capacitance : 0.001; }
    pin (ZN) { direction : output; function : "(A1 * A2)'"; }
  }
  cell (FDC) {
    area : 8;
    ff (IQ, IQN) { clocked_on : "CP"; next_state : "D"; clear : "CDN'"; }
    pin (D) { direction : input; capacitance : 0.001; }
    pin (CP) { direction : input; capacitance : 0.001; clock : true; }
    pin (CDN) { direction : input; capacitance : 0.001; }
    pin (Q) { direction : output; function : "IQ"; }
    pin (QN) { direction : output; function : "IQN"; }
  }
}
