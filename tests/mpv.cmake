# mpv drc self-test: SKY130 standard cells are clean under tests/pv/sky130.drc,
# a layout with known violations reports each of them, and the report is the
# same on one thread and on many.
#   cmake -DMPV=<mpv> -DGEN=<test_pv> -DSRC=<source dir> -DOUT=<scratch dir> -P mpv.cmake
file(MAKE_DIRECTORY ${OUT})

function(run want_rc)
  execute_process(COMMAND ${MPV} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(out "${out}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
  if(NOT rc EQUAL ${want_rc})
    message(FATAL_ERROR "mpv ${ARGN} exited ${rc}, expected ${want_rc}\n${out}${err}")
  endif()
endfunction()

function(expect text)
  string(FIND "${out}" "${text}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing: ${text}\n${out}")
  endif()
endfunction()

# Real cells: clean.
foreach(cell inv_1 nand2_1 mux2_1 dfxtp_1)
  run(0 drc -deck ${SRC}/tests/pv/sky130.drc ${SRC}/tests/pv/sky130/sky130_fd_sc_hd__${cell}.gds)
  expect("cell sky130_fd_sc_hd__${cell}")
  expect("0 violations in 0 of 40 rules")
endforeach()

# The same cell against a tighter rule: the tool does report what is there.
file(READ ${SRC}/tests/pv/sky130.drc deck)
string(REPLACE "width(li) < 0.17" "width(li) < 0.18" deck "${deck}")
file(WRITE ${OUT}/tight.drc "${deck}")
run(1 drc -deck ${OUT}/tight.drc ${SRC}/tests/pv/sky130/sky130_fd_sc_hd__inv_1.gds -q)
expect("li.1")
if(out MATCHES "poly.1a")
  message(FATAL_ERROR "-q printed a clean rule:\n${out}")
endif()

# Known violations, with a cell reference and a path in the layout.
execute_process(COMMAND ${GEN} -gen ${OUT} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "test_pv -gen failed")
endif()
run(1 drc -deck ${SRC}/tests/pv/mini.drc ${OUT}/pv_bad.gds -o ${OUT}/bad.txt -rdb ${OUT}/bad.lyrdb -threads 1)
set(one "${out}")
expect("cell bad, 6 shapes on 3 layers, 5 x 5 um, 1 unit = 0.001 um")
expect("M.W         1  metal width")
expect("M.S         1  metal spacing")
expect("M.A         1  metal area")
expect("V.SZ        0  via must be 0.17 x 0.17")
expect("V.E         1  metal enclosure of via")
expect("M.D         1  metal density in 5 um windows")
expect("5 violations in 5 of 6 rules")
file(READ ${OUT}/bad.txt out)
expect("rule M.W 1 \"metal width\"\n  0 0.42 2 0.52 0.1\n")
expect("rule M.S 1 \"metal spacing\"\n  0 0.3 2 0.42 0.12\n")
expect("rule M.A 1 \"metal area\"\n  3 2.9 3.4 3.1 0.08\n")
expect("rule V.E 1 \"metal enclosure of via\"\n  1 0 1.17 0.02 0.02\n")
expect("rule M.D 1 \"metal density in 5 um windows\"\n  0 0 5 5 0.0352\n")
# The same markers as a KLayout report database.
file(READ ${OUT}/bad.lyrdb out)
expect("<top-cell>bad</top-cell>")
expect("<name>V.SZ</name>\n   <description>via must be 0.17 x 0.17</description>")
expect("<category>'M.W'</category>\n   <cell>bad</cell>")
expect("<value>box: (0,0.42;2,0.52)</value>\n    <value>float: 0.1</value>")
expect("<value>box: (0,0;5,5)</value>\n    <value>float: 0.0352</value>")
string(REGEX MATCHALL "<item>" items "${out}")
list(LENGTH items n)
if(NOT n EQUAL 5 OR NOT out MATCHES "</report-database>\n$")
  message(FATAL_ERROR "report database: ${n} items")
endif()
run(1 drc -deck ${SRC}/tests/pv/mini.drc ${OUT}/pv_bad.gds -threads 4)
if(NOT out STREQUAL one)
  message(FATAL_ERROR "-threads 4 and -threads 1 differ:\n${one}\n---\n${out}")
endif()

# Errors: exit 2 with the reason.
run(2 drc -deck ${SRC}/tests/pv/mini.drc ${OUT}/pv_bad.gds -top nosuch)
if(NOT err MATCHES "no cell named nosuch")
  message(FATAL_ERROR "bad -top: ${err}")
endif()
run(2 drc -deck ${SRC}/tests/pv/mini.drc ${SRC}/tests/pv/mini.drc)
if(NOT err MATCHES "not a GDSII stream|bad record|truncated")
  message(FATAL_ERROR "not a GDS file: ${err}")
endif()
file(WRITE ${OUT}/broken.drc "layer m 1\nrule r width(m < 0.1\n")
run(2 drc -deck ${OUT}/broken.drc ${OUT}/pv_bad.gds)
if(NOT err MATCHES "broken.drc: line 2: expected \\) in width")
  message(FATAL_ERROR "deck error: ${err}")
endif()

# LVS extraction: the flop has 24 transistors, as in the PDK netlist.
run(0 lvs -deck ${SRC}/tests/pv/sky130.lvs ${SRC}/tests/pv/sky130/sky130_fd_sc_hd__dfxtp_1.gds -o ${OUT}/dfxtp.spice)
expect("cell sky130_fd_sc_hd__dfxtp_1, 24 devices, 18 nets, 7 ports")
expect("sky130_fd_pr__nfet_01v8          12")
file(READ ${OUT}/dfxtp.spice out)
expect(".subckt sky130_fd_sc_hd__dfxtp_1 CLK D Q VGND VNB VPB VPWR\n")
expect("M22 VPWR n14 n16 VPB sky130_fd_pr__pfet_01v8_hvt w=1 l=0.15\n")
run(2 lvs -deck ${SRC}/tests/pv/mini.drc ${OUT}/pv_bad.gds)

# Rules in the SVRF style: the same answers as the native decks.
run(1 drc -svrf ${SRC}/tests/pv/mini.svrf ${OUT}/pv_bad.gds -o ${OUT}/bad_svrf.txt -write-deck ${OUT}/mini_svrf.drc)
expect("M.W         1  metal width")
expect("V.E         1  metal enclosure of via")
expect("M.D         1  metal density in 5 um windows")
expect("5 violations in 5 of 5 rules")
file(READ ${OUT}/bad_svrf.txt out)
expect("rule M.S 1 \"metal spacing\"\n  0 0.3 2 0.42 0.12\n")
expect("rule M.D 1 \"metal density in 5 um windows\"\n  0 0 5 5 0.0352\n")
file(READ ${OUT}/mini_svrf.drc out)
expect("layer metal 1/*\n")
expect("rule V.E enclosure(via, metal) < 0.03 \"metal enclosure of via\"\n")
foreach(cell inv_1 dfxtp_1)
  run(0 drc -svrf ${SRC}/tests/pv/sky130.svrf ${SRC}/tests/pv/sky130/sky130_fd_sc_hd__${cell}.gds)
  expect("0 violations in 0 of 30 rules")
endforeach()
if(NOT err MATCHES "rule nwell.1: options not applied: ABUT < 90 SINGULAR REGION" OR NOT err MATCHES "statements not applied: DRC RESULTS; LAYOUT SYSTEM; PRECISION")
  message(FATAL_ERROR "svrf warnings: ${err}")
endif()
run(0 drc -svrf ${SRC}/tests/pv/sky130.svrf -D WITH_DENSITY ${SRC}/tests/pv/sky130/sky130_fd_sc_hd__inv_1.gds)
expect("0 of 31 rules")
file(WRITE ${OUT}/bad.svrf "LAYER a 1\nR { INT a <= 0.1 }\n")
run(2 drc -svrf ${OUT}/bad.svrf ${OUT}/pv_bad.gds)
if(NOT err MATCHES "bad.svrf: line 2: the constraint <= is not supported on INT")
  message(FATAL_ERROR "svrf error: ${err}")
endif()
run(2 drc -svrf ${SRC}/tests/pv/mini.svrf -deck ${SRC}/tests/pv/mini.drc ${OUT}/pv_bad.gds)

# OASIS layouts (plain and with compressed blocks): the same answers as GDSII.
run(0 drc -deck ${SRC}/tests/pv/sky130.drc ${SRC}/tests/pv/oasis/sky130_fd_sc_hd__inv_1.oas)
expect("cell sky130_fd_sc_hd__inv_1")
expect("0 violations in 0 of 40 rules")
run(0 lvs -deck ${SRC}/tests/pv/sky130.lvs ${SRC}/tests/pv/oasis/sky130_fd_sc_hd__dfxtp_1.oas -o ${OUT}/dfxtp_oas.spice)
expect("cell sky130_fd_sc_hd__dfxtp_1, 24 devices, 18 nets, 7 ports")
file(READ ${OUT}/dfxtp_oas.spice oas)
file(READ ${OUT}/dfxtp.spice out)
if(NOT oas STREQUAL out)
  message(FATAL_ERROR "the netlist from OASIS differs from the one from GDSII")
endif()
file(WRITE ${OUT}/cut.oas "%SEMI-OASIS\r\nnot a record")
run(2 drc -deck ${SRC}/tests/pv/sky130.drc ${OUT}/cut.oas)
if(NOT err MATCHES "cut.oas")
  message(FATAL_ERROR "a bad OASIS file: ${err}")
endif()

# A routed DEF with its LEF, rules from the LEF technology: the metal is
# clean, and two pairs of v2 cuts are closer than the cut spacing.
run(1 drc -lef ${SRC}/tests/pv/def/tiny.lef ${SRC}/tests/pv/def/counter.def -write-deck ${OUT}/tiny.drc -o ${OUT}/counter.txt)
expect("cell counter, 607 shapes on 7 layers, 17.1 x 18.2 um, 1 unit = 0.0005 um")
expect("m2.space        0  m2 spacing")
expect("v2.space        2  v2 spacing")
expect("2 violations in 1 of 27 rules")
file(READ ${OUT}/tiny.drc out)
expect("layer m1 1/0\n")
expect("rule m1.width width(m1) < 0.07 \"m1 width\"\n")
expect("rule v1.above v1 - m2 \"v1 without m2\"\n")
# The written deck gives the same result when passed back with -deck.
run(1 drc -lef ${SRC}/tests/pv/def/tiny.lef -deck ${OUT}/tiny.drc ${SRC}/tests/pv/def/counter.def -q)
expect("2 violations in 1 of 27 rules")
# The same block after the router learned the cut spacing rule is clean.
run(0 drc -lef ${SRC}/tests/pv/def/tiny.lef ${SRC}/tests/pv/def/counter_clean.def -q)
expect("0 violations in 0 of 27 rules")
run(2 drc -deck ${OUT}/tiny.drc ${SRC}/tests/pv/def/counter.def)

# Block LVS: the routed counter against its gate netlist. The nets come from
# the geometry, so a missing via is an open and a stray wire is a short.
set(DEFDIR ${SRC}/tests/pv/def)
run(0 lvs -lef ${DEFDIR}/tiny.lef ${DEFDIR}/counter_clean.def -netlist ${DEFDIR}/counter.v -o ${OUT}/counter_ext.v -threads 1)
expect("block counter, 49 instances, 150 pins, 27 nets, 9 ports")
expect("note: net VDD of the DEF is 3 separate nets in the layout")
expect("MATCH: 49 instances, 21 nets and 9 ports compared")
set(one "${out}")
run(0 lvs -lef ${DEFDIR}/tiny.lef ${DEFDIR}/counter_clean.def -netlist ${DEFDIR}/counter.v -threads 4)
if(NOT out STREQUAL one)
  message(FATAL_ERROR "block lvs: -threads 4 and -threads 1 differ:\n${one}\n---\n${out}")
endif()
file(READ ${OUT}/counter_ext.v out)
expect("XOR2 \\ha0/u_s  (.A(\\q[0] ), .B(en), .Y(\\s[0] ), .VDD(VDD), .VSS(VSS));")
# Extraction alone, without a netlist.
run(0 lvs -lef ${DEFDIR}/tiny.lef ${DEFDIR}/counter_clean.def)
expect("block counter, 49 instances")

file(READ ${DEFDIR}/counter_clean.def def)
file(READ ${DEFDIR}/counter.v gates)
# An open: the via onto pin m0/A is gone.
string(REPLACE "via12_pin\n    NEW m1 ( 15010 23100 ) via12_pin ;" "via12_pin ;" bad "${def}")
file(WRITE ${OUT}/open.def "${bad}")
run(1 lvs -lef ${DEFDIR}/tiny.lef ${OUT}/open.def -netlist ${DEFDIR}/counter.v)
expect("open: net s[0] is in 2 pieces in the layout: [ha0/u_s/Y] [m0/A]")
expect("MISMATCH: 49 instances, 21 nets and 9 ports compared, 1 opens, 0 shorts")
# A short: a piece of m3 from net s[0] onto net 1'b0.
string(REPLACE "  + ROUTED m3 ( 13490 23100 ) ( 15010 * )\n" "  + ROUTED m3 ( 13490 23100 ) ( 15010 * )\n    NEW m3 ( 15010 23100 ) ( * 23380 )\n" bad "${def}")
file(WRITE ${OUT}/short.def "${bad}")
run(1 lvs -lef ${DEFDIR}/tiny.lef ${OUT}/short.def -netlist ${DEFDIR}/counter.v)
expect("short: 2 nets of the netlist are one net in the layout (1'b0): s[0] [ha0/u_s/Y, m0/A] 1'b0 [m0/B, m0/S, mpnr_tielo/Y]")
expect("1 shorts")
# The netlist says another net, another cell, one cell less, an open pin.
string(REPLACE "AND2 \\ha0/u_c  (.A(q[0]), .B(en)" "AND2 \\ha0/u_c  (.A(q[0]), .B(clk)" bad "${gates}")
file(WRITE ${OUT}/wrongnet.v "${bad}")
run(1 lvs -lef ${DEFDIR}/tiny.lef ${DEFDIR}/counter_clean.def -netlist ${OUT}/wrongnet.v)
expect("open: net clk is in 2 pieces in the layout: [ha0/u_c/B] [r0/CK, r1/CK, r2/CK, r3/CK, ... (5 pins)]")
expect("short: 2 nets of the netlist are one net in the layout (en): clk [ha0/u_c/B] en [ha0/u_s/B, port en]")
string(REPLACE "XOR2 \\ha1/u_s " "AND2 \\ha1/u_s " bad "${gates}")
file(WRITE ${OUT}/wrongcell.v "${bad}")
run(1 lvs -lef ${DEFDIR}/tiny.lef ${DEFDIR}/counter_clean.def -netlist ${OUT}/wrongcell.v)
expect("instance ha1/u_s is XOR2 in the layout and AND2 in the netlist")
string(REPLACE "  BUF b1 (.A(\\s[1] ), .Y(\\d[1] ));\n" "" bad "${gates}")
file(WRITE ${OUT}/missing.v "${bad}")
run(1 lvs -lef ${DEFDIR}/tiny.lef ${DEFDIR}/counter_clean.def -netlist ${OUT}/missing.v)
expect("instance b1 (BUF) is in the layout but not in the netlist")
string(REPLACE ".Y(carry)" ".Y()" bad "${gates}")
file(WRITE ${OUT}/loose.v "${bad}")
run(1 lvs -lef ${DEFDIR}/tiny.lef ${DEFDIR}/counter_clean.def -netlist ${OUT}/loose.v)
expect("ha3/u_c/Y is not connected in the netlist but is on net carry in the layout")
run(2 lvs ${DEFDIR}/counter_clean.def -netlist ${DEFDIR}/counter.v)
