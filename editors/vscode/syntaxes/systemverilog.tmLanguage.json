{
 "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
 "name": "SystemVerilog",
 "scopeName": "source.systemverilog",
 "patterns": [
  {
   "include": "#comments"
  },
  {
   "include": "#strings"
  },
  {
   "include": "#directives"
  },
  {
   "include": "#numbers"
  },
  {
   "include": "#system"
  },
  {
   "include": "#declarations"
  },
  {
   "include": "#keywords"
  },
  {
   "include": "#types"
  },
  {
   "include": "#operators"
  }
 ],
 "repository": {
  "comments": {
   "patterns": [
    {
     "name": "comment.line.double-slash.systemverilog",
     "begin": "//",
     "end": "$"
    },
    {
     "name": "comment.block.systemverilog",
     "begin": "/\\*",
     "end": "\\*/"
    }
   ]
  },
  "strings": {
   "patterns": [
    {
     "name": "string.quoted.triple.systemverilog",
     "begin": "\"\"\"",
     "end": "\"\"\""
    },
    {
     "name": "string.quoted.double.systemverilog",
     "begin": "\"",
     "end": "\"",
     "patterns": [
      {
       "name": "constant.character.escape.systemverilog",
       "match": "\\\\."
      },
      {
       "name": "constant.other.placeholder.systemverilog",
       "match": "%[-+0 #]*\\d*(\\.\\d+)?[bBoOdDhHxXcCsStTmMvVeEfFgGzZpPlLuU%]"
      }
     ]
    }
   ]
  },
  "directives": {
   "patterns": [
    {
     "match": "(`include)\\s*(\"[^\"]*\"|<[^>]*>)",
     "captures": {
      "1": {
       "name": "keyword.control.directive.systemverilog"
      },
      "2": {
       "name": "string.quoted.other.systemverilog"
      }
     }
    },
    {
     "match": "(`define)\\s+([A-Za-z_][A-Za-z0-9_$]*)",
     "captures": {
      "1": {
       "name": "keyword.control.directive.systemverilog"
      },
      "2": {
       "name": "entity.name.function.macro.systemverilog"
      }
     }
    },
    {
     "name": "keyword.control.directive.systemverilog",
     "match": "`(ifdef|ifndef|elsif|else|endif|undef|undefineall|timescale|default_nettype|resetall|celldefine|endcelldefine|line|pragma|begin_keywords|end_keywords|unconnected_drive|nounconnected_drive|protect|endprotect)\\b"
    },
    {
     "name": "entity.name.function.macro.systemverilog",
     "match": "`[A-Za-z_][A-Za-z0-9_$]*"
    }
   ]
  },
  "numbers": {
   "patterns": [
    {
     "name": "constant.numeric.systemverilog",
     "match": "\\b\\d[\\d_]*\\s*'[sS]?[bBoOdDhH]\\s*[0-9a-fA-FxXzZ?_]+\\b|'[sS]?[bBoOdDhH]\\s*[0-9a-fA-FxXzZ?_]+\\b"
    },
    {
     "name": "constant.numeric.systemverilog",
     "match": "'[01xXzZ]\\b"
    },
    {
     "name": "constant.numeric.time.systemverilog",
     "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?(fs|ps|ns|us|ms|s)\\b"
    },
    {
     "name": "constant.numeric.systemverilog",
     "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][-+]?\\d+)?\\b"
    }
   ]
  },
  "system": {
   "name": "support.function.system.systemverilog",
   "match": "\\$[A-Za-z_][A-Za-z0-9_$]*"
  },
  "declarations": {
   "patterns": [
    {
     "match": "\\b(module|macromodule|interface|program|package|primitive|checker|class|covergroup|property|sequence|config)\\s+(?:(?:automatic|static|virtual)\\s+)?([A-Za-z_][A-Za-z0-9_$]*)",
     "captures": {
      "1": {
       "name": "storage.type.systemverilog"
      },
      "2": {
       "name": "entity.name.type.systemverilog"
      }
     }
    },
    {
     "match": "\\b(function|task)\\s+(?:(?:automatic|static|virtual|pure|extern)\\s+)*(?:[A-Za-z_][A-Za-z0-9_$:]*\\s*(?:\\[[^\\]]*\\]\\s*)*\\s+)?([A-Za-z_][A-Za-z0-9_$]*)\\s*(?=[(;])",
     "captures": {
      "1": {
       "name": "storage.type.systemverilog"
      },
      "2": {
       "name": "entity.name.function.systemverilog"
      }
     }
    },
    {
     "match": "^\\s*(?!(?:else|end|begin|if|case|casex|casez|for|while|do|return|assert|assume|cover|wait|repeat|foreach|forever|disable|unique|unique0|priority|always|always_comb|always_ff|always_latch|initial|final|assign|import|export|typedef|input|output|inout|ref|const|static|virtual|extern|pure|local|protected|rand|randc|logic|bit|byte|wire|reg|int|integer|function|task|new|fork|join|module|interface|program|package|class|property|sequence|covergroup|constraint|parameter|localparam|default|void|string)\\b)([A-Za-z_][A-Za-z0-9_$]*)\\s+(?:#\\s*\\(.*?\\)\\s*)?([A-Za-z_][A-Za-z0-9_$]*)\\s*(?=\\()",
     "captures": {
      "1": {
       "name": "entity.name.type.module.systemverilog"
      },
      "2": {
       "name": "variable.other.instance.systemverilog"
      }
     }
    }
   ]
  },
  "keywords": {
   "patterns": [
    {
     "name": "keyword.other.systemverilog",
     "match": "\\b(module|endmodule|macromodule|interface|endinterface|program|endprogram|package|endpackage|class|endclass|function|endfunction|task|endtask|primitive|endprimitive|checker|endchecker|config|endconfig|covergroup|endgroup|property|endproperty|sequence|endsequence|clocking|endclocking|specify|endspecify|generate|endgenerate|modport|typedef|enum|struct|union|packed|tagged|import|export|extends|implements|virtual|pure|extern|static|automatic|local|protected|const|var|parameter|localparam|specparam|defparam|genvar|input|output|inout|ref|let|bind|alias|nettype|interconnect|constraint|rand|randc|solve|before|coverpoint|cross|bins|illegal_bins|ignore_bins|binsof|intersect|with|type|timeunit|timeprecision|library|incdir|include|design|instance|cell|liblist|use|context|forkjoin)\\b"
    },
    {
     "name": "keyword.control.systemverilog",
     "match": "\\b(begin|end|if|else|case|casex|casez|endcase|unique|unique0|priority|default|for|foreach|forever|repeat|while|do|break|continue|return|fork|join|join_any|join_none|wait|wait_order|disable|always|always_comb|always_ff|always_latch|initial|final|assign|deassign|force|release|posedge|negedge|edge|or|and|not|iff|inside|dist|matches|assert|assume|cover|expect|restrict|throughout|within|intersect|first_match|until|until_with|s_until|s_until_with|eventually|s_eventually|nexttime|s_nexttime|accept_on|reject_on|sync_accept_on|sync_reject_on|implies|new|this|super|null|randomize|randcase|randsequence|std)\\b"
    }
   ]
  },
  "types": {
   "name": "storage.type.systemverilog",
   "match": "\\b(logic|bit|byte|shortint|int|longint|integer|time|real|shortreal|realtime|reg|wire|wand|wor|tri|tri0|tri1|triand|trior|trireg|supply0|supply1|uwire|string|chandle|event|void|signed|unsigned|mailbox|semaphore|genvar|small|medium|large|strong0|strong1|weak0|weak1|pull0|pull1|highz0|highz1)\\b"
  },
  "operators": {
   "name": "keyword.operator.systemverilog",
   "match": "(<<<?=?|>>>?=?|[-+*/%&|^~!=<>]=?|\\?|::|->|<->|\\|->|\\|=>|##|@@?|#)"
  }
 }
}