{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"], ["begin", "end"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "wordPattern": "(\\\\\\S+)|([a-zA-Z_][a-zA-Z0-9_$]*)|(\\$[a-zA-Z_][a-zA-Z0-9_$]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(.*\\bbegin\\b|.*\\bfork\\b|\\b(module|interface|program|package|class|function|task|case|casez|casex|generate|covergroup|property|sequence|clocking|specify|config|checker)\\b)(?!.*\\b(end|join|join_any|join_none|endmodule|endinterface|endprogram|endpackage|endclass|endfunction|endtask|endcase|endgenerate|endgroup|endproperty|endsequence|endclocking|endspecify|endconfig|endchecker)\\b).*$",
    "decreaseIndentPattern": "^\\s*(end|join|join_any|join_none|endmodule|endinterface|endprogram|endpackage|endclass|endfunction|endtask|endcase|endgenerate|endgroup|endproperty|endsequence|endclocking|endspecify|endconfig|endchecker)\\b"
  }
}
