{
  "name": "minisim",
  "displayName": "minisim SystemVerilog",
  "description": "SystemVerilog and Verilog for the minisim tools: errors as you type (slang), mlint on save, go to definition, references, hover, outline, run msim, waveforms in mdebug, coverage from mcov, and the minisim MCP server for agents.",
  "version": "0.1.0",
  "publisher": "minisim",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonythetiger168/minisim",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Testing"
  ],
  "keywords": [
    "systemverilog",
    "verilog",
    "hdl",
    "simulation",
    "lint",
    "lsp"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.{sv,svh,v,vh}"
  ],
  "contributes": {
    "languages": [
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh",
          ".svi",
          ".sva",
          ".svp"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh",
          ".vp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "minisim.runSimulation",
        "title": "Run Simulation (msim)",
        "category": "minisim"
      },
      {
        "command": "minisim.lint",
        "title": "Lint Design (mlint)",
        "category": "minisim"
      },
      {
        "command": "minisim.openWaveform",
        "title": "Open Waveform (mdebug)",
        "category": "minisim"
      },
      {
        "command": "minisim.showCoverage",
        "title": "Show Coverage (mcov)",
        "category": "minisim"
      },
      {
        "command": "minisim.restartServer",
        "title": "Restart Language Server (mlsp)",
        "category": "minisim"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "minisim.runSimulation",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "minisim",
      "properties": {
        "minisim.binDir": {
          "type": "string",
          "default": "",
          "description": "Directory with the minisim programs (mlsp, msim, mlint, mdebug, mcov, mmcp). Empty: search PATH."
        },
        "minisim.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Front-end options for every analysis and run, as on the msim command line: +incdir+DIR, +define+NAME=VALUE, -DNAME, --std=1800-2017."
        },
        "minisim.fileList": {
          "type": "string",
          "default": "",
          "description": "A -f file list (relative to the workspace). Empty: mlsp follows the open file's design through the workspace."
        },
        "minisim.uvmHome": {
          "type": "string",
          "default": "",
          "description": "The UVM library for import uvm_pkg::* (default: $UVM_HOME)."
        },
        "minisim.mlint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run mlint when a file is saved and show its findings."
        },
        "minisim.mlint.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra mlint options, e.g. [\"-goal\", \"design\"] or [\"-config\", \"lint.cfg\"]."
        },
        "minisim.msim.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra msim options for Run Simulation, e.g. [\"-seed\", \"1\", \"+UVM_TESTNAME=smoke\"]."
        },
        "minisim.waveform": {
          "type": "string",
          "enum": [
            "fst",
            "vcd",
            "none"
          ],
          "default": "fst",
          "description": "Waveform format Run Simulation writes (to .minisim/ in the workspace)."
        },
        "minisim.coverage": {
          "type": "boolean",
          "default": false,
          "description": "Run Simulation also collects code coverage (msim -cov), shown with Show Coverage."
        },
        "minisim.mcp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Offer the minisim MCP server (mmcp) to agents in VS Code (chat agent mode)."
        },
        "minisim.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the protocol between VS Code and mlsp."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "msim",
        "owner": "minisim",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|note): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "minisim.mcp",
        "label": "minisim"
      }
    ],
    "taskDefinitions": [
      {
        "type": "minisim",
        "required": [
          "tool"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "description": "msim or mlint"
          },
          "top": {
            "type": "string",
            "description": "the top module"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "node --test out/test/util.test.js",
    "package": "vsce package -o minisim.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.101.0",
    "typescript": "^5.6.0"
  }
}
